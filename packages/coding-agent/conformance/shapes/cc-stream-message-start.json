{
	"type": "stream_event",
	"event": {
		"type": "message_start",
		"message": {
			"id": "$string",
			"type": "message",
			"role": "assistant",
			"model": "$string",
			"content": [],
			"stop_reason": "$null",
			"stop_sequence": "$null",
			"usage": {
				"input_tokens": "$number",
				"output_tokens": "$number",
				"?cache_creation_input_tokens": "$number",
				"?cache_read_input_tokens": "$number"
			}
		}
	},
	"session_id": "$uuid",
	"parent_tool_use_id": "$null",
	"uuid": "$uuid",
	"api_message_id": "$string",
	"ttft_ms": "$number",
	"thinking_display": "$string"
}
