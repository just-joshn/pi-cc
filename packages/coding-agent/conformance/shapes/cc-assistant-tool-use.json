{
	"type": "assistant",
	"message": {
		"id": "$string",
		"type": "message",
		"role": "assistant",
		"model": "$string",
		"content": [
			{
				"type": "tool_use",
				"id": "$string",
				"name": "$string",
				"input": "$object"
			}
		],
		"stop_reason": "$null",
		"stop_sequence": "$null",
		"usage": {
			"input_tokens": "$number",
			"output_tokens": "$number",
			"?cache_creation_input_tokens": "$number",
			"?cache_read_input_tokens": "$number"
		},
		"context_management": "$null"
	},
	"parent_tool_use_id": "$null",
	"session_id": "$uuid",
	"uuid": "$uuid",
	"timestamp": "$iso8601",
	"?request_id": "$string"
}
