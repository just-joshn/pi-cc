{
	"id": "tool/edit-same-mtime-no-suffix",
	"area": "tool",
	"argv": [
		"-p",
		"Run the fixture probes",
		"--model",
		"claude-opus-5-5",
		"--permission-mode",
		"acceptEdits",
		"--allowedTools",
		"Bash",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"s.txt": "one\ntwo\nthree\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "s.txt"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "touch -r s.txt s.stamp; printf 'Z%s' \"$(cat s.txt)\" > s.txt; touch -r s.stamp s.txt; rm s.stamp"
					}
				}
			},
			{
				"tool_use": {
					"name": "Edit",
					"input": {
						"file_path": "s.txt",
						"old_string": "two",
						"new_string": "TWO"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"The file s.txt has been updated successfully."
			]
		},
		"files": [
			{
				"path": "s.txt",
				"contains": [
					"Zone\nTWO"
				]
			}
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 4,
				"bodyMatch": [
					"The file s.txt has been updated successfully."
				],
				"bodyNotMatch": [
					"file state is current"
				]
			}
		]
	}
}
