{
	"id": "tool/edit-result-text",
	"area": "tool",
	"argv": [
		"-p",
		"Edit the fixture file",
		"--permission-mode",
		"acceptEdits",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {},
	"stdin": null,
	"files": {
		"edit_fixture.txt": "PROBE_EDIT_OLD\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "edit_fixture.txt"
					}
				}
			},
			{
				"tool_use": {
					"name": "Edit",
					"input": {
						"file_path": "edit_fixture.txt",
						"old_string": "PROBE_EDIT_OLD",
						"new_string": "PROBE_EDIT_NEW"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"The file edit_fixture.txt has been updated successfully."
			]
		},
		"files": [
			"edit_fixture.txt"
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 3
			}
		]
	},
	"skip": []
}
