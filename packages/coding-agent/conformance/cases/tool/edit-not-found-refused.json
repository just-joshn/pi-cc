{
	"id": "tool/edit-not-found-refused",
	"area": "tool",
	"argv": [
		"-p",
		"Edit the fixture",
		"--permission-mode",
		"acceptEdits",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {},
	"stdin": null,
	"files": {
		"one.txt": "PROBE_ONLY_LINE\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "one.txt"
					}
				}
			},
			{
				"tool_use": {
					"name": "Edit",
					"input": {
						"file_path": "one.txt",
						"old_string": "PROBE_ABSENT",
						"new_string": "PROBE_X"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"<tool_use_error>String to replace not found in file."
			]
		},
		"files": [],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 3
			}
		]
	},
	"skip": []
}
