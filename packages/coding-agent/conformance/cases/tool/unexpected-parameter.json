{
	"id": "tool/unexpected-parameter",
	"area": "tool",
	"argv": ["-p", "Edit the fixture", "--output-format", "stream-json", "--verbose"],
	"env": {},
	"stdin": null,
	"files": {
		"f.txt": "hello\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Edit",
					"input": {
						"file_path": "f.txt",
						"old_string": "hello",
						"new_string": "HELLO",
						"bogus_field": true
					}
				}
			},
			{ "text": "PROBE_OK" }
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": ["An unexpected parameter `bogus_field` was provided"]
		},
		"files": []
	},
	"skip": []
}
