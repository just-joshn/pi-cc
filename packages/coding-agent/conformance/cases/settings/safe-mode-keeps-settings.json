{
	"id": "settings/safe-mode-keeps-settings",
	"area": "settings",
	"argv": ["-p", "Reply with exactly PROBE_OK", "--safe-mode"],
	"env": {},
	"stdin": null,
	"files": {
		".claude/settings.json": "{\"model\":\"claude-sonnet-4-5\"}\n"
	},
	"model": {
		"turns": [{ "text": "PROBE_OK" }]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"bodyEquals": { "model": "claude-sonnet-4-5" }
			}
		]
	},
	"skip": []
}
