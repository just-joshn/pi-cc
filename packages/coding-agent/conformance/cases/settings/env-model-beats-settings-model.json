{
	"id": "settings/env-model-beats-settings-model",
	"area": "settings",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$CONFIG/settings.json": "{\"model\": \"claude-haiku-4-5\", \"env\": {\"ANTHROPIC_MODEL\": \"claude-sonnet-4-5\"}}\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"bodyEquals": {
					"model": "claude-sonnet-4-5"
				}
			}
		]
	},
	"skip": []
}
