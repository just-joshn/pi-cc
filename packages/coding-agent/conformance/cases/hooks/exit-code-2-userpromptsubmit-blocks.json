{
	"id": "hooks/exit-code-2-userpromptsubmit-blocks",
	"area": "hooks",
	"argv": [
		"-p",
		"Run the probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose",
		"--include-hook-events",
		"--settings",
		"{\"hooks\":{\"UserPromptSubmit\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"echo UPS_E2 >&2; exit 2\"}]}]}}"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"UserPromptSubmit operation blocked by hook:\\\\n\\[echo UPS_E2 >&2; exit 2\\]: UPS_E2\\\\n\\\\n\\\\nOriginal prompt: Run the probes"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 0
			}
		]
	},
	"skip": []
}
