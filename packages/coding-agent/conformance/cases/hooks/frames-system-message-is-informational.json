{
	"id": "hooks/frames-system-message-is-informational",
	"area": "hooks",
	"argv": [
		"-p",
		"Run the probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose",
		"--include-hook-events",
		"--settings",
		"{\"hooks\":{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '%s' '{\\\"systemMessage\\\":\\\"SYSM\\\"}'\"}]}]}}"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "seed.txt"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"\"subtype\":\"informational\",\"content\":\"PreToolUse:Read says: SYSM\",\"level\":\"notice\""
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2,
				"index": -1
			}
		]
	},
	"skip": []
}
