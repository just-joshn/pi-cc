{
	"id": "hooks/exit-code-2-permissionrequest-is-ignored",
	"area": "hooks",
	"argv": [
		"-p",
		"Run the probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose",
		"--include-hook-events",
		"--settings",
		"{\"hooks\":{\"PermissionRequest\":[{\"matcher\":\"Bash\",\"hooks\":[{\"type\":\"command\",\"command\":\"echo PR_E2 >&2; exit 2\"}]}]}}"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "touch ran.txt"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"absent": [
			"$WORKSPACE/ran.txt"
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2,
				"bodyAt": {
					"messages.2.content.0.content": {
						"match": [
							"^touch in "
						]
					}
				},
				"index": -1
			}
		]
	},
	"skip": []
}
