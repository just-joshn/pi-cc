{
	"id": "hooks/hook-exec-form",
	"area": "hooks",
	"argv": [
		"-p",
		"Run the probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose",
		"--include-hook-events",
		"--settings",
		"{\"hooks\":{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"/bin/sh\",\"args\":[\"-c\",\"cat >> ev.jsonl; echo >> ev.jsonl\"]}]}]}}",
		"--allowedTools",
		"Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo 1"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"files": [
			{
				"path": "ev.jsonl",
				"contains": [
					"\"hook_event_name\":\"PreToolUse\""
				]
			}
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2,
				"index": -1
			}
		]
	},
	"skip": []
}
