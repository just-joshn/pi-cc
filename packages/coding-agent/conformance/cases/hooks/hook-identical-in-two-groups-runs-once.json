{
	"id": "hooks/hook-identical-in-two-groups-runs-once",
	"area": "hooks",
	"argv": [
		"-p",
		"Run the probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose",
		"--include-hook-events",
		"--settings",
		"{\"hooks\":{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"echo hit >> ev.jsonl\"}]},{\"matcher\":\"Bash\",\"hooks\":[{\"type\":\"command\",\"command\":\"echo hit >> ev.jsonl\"}]}]}}",
		"--allowedTools",
		"Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo 1"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"files": [
			{
				"path": "ev.jsonl",
				"contains": [
					"hit\n"
				]
			}
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2,
				"index": -1
			}
		]
	},
	"skip": []
}
