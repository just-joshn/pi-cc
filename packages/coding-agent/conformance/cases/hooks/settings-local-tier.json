{
	"id": "hooks/settings-local-tier",
	"area": "hooks",
	"argv": [
		"-p",
		"Run the probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose",
		"--include-hook-events",
		"--allowedTools",
		"Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		".claude/settings.local.json": "{\"hooks\": {\"PreToolUse\": [{\"hooks\": [{\"type\": \"command\", \"command\": \"cat >> ev.jsonl; echo >> ev.jsonl\"}]}]}}",
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "touch ran.txt"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"files": [
			"ev.jsonl",
			"ran.txt"
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		]
	},
	"skip": []
}
