{
	"id": "hooks/payload-shape-posttooluse-read",
	"area": "hooks",
	"argv": [
		"-p",
		"Run the probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose",
		"--include-hook-events",
		"--settings",
		"{\"hooks\":{\"PostToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"cat >> ev.jsonl; echo >> ev.jsonl\"}]}]}}"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "seed.txt"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"files": [
			{
				"path": "ev.jsonl",
				"contains": [
					"\"tool_response\":{\"type\":\"text\",\"file\":{\"filePath\":\"seed.txt\",\"content\":\"SEED\\n\",\"numLines\":2,\"startLine\":1,\"totalLines\":2}}"
				]
			}
		]
	},
	"skip": []
}
