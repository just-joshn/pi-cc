{
	"id": "hooks/pretooluse-additional-context",
	"area": "hooks",
	"argv": [
		"-p",
		"Run the probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose",
		"--include-hook-events",
		"--settings",
		"{\"hooks\":{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '%s' '{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"additionalContext\\\":\\\"CTX_FROM_PRE\\\"}}'\"}]}]}}",
		"--allowedTools",
		"Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "touch ran.txt"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"files": [
			"ran.txt"
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2,
				"bodyAt": {
					"messages.2.content.1.text": {
						"match": [
							"^<system-reminder>\\nPreToolUse:Bash hook additional context: CTX_FROM_PRE\\n</system-reminder>$"
						]
					}
				},
				"index": -1
			}
		]
	},
	"skip": []
}
