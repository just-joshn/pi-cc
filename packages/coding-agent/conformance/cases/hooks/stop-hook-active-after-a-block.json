{
	"id": "hooks/stop-hook-active-after-a-block",
	"area": "hooks",
	"argv": [
		"-p",
		"Run the probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose",
		"--include-hook-events",
		"--settings",
		"{\"hooks\":{\"Stop\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"cat >> ev.jsonl; echo >> ev.jsonl; if [ $(wc -l < ev.jsonl) -lt 4 ]; then echo X >&2; exit 2; fi\"}]}]}}"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n"
	},
	"model": {
		"turns": [
			{
				"text": "T0"
			},
			{
				"text": "T1"
			},
			{
				"text": "T2"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"files": [
			{
				"path": "ev.jsonl",
				"contains": [
					"\"stop_hook_active\":false,\"last_assistant_message\":\"T0\"",
					"\"stop_hook_active\":true,\"last_assistant_message\":\"T1\""
				]
			}
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2,
				"index": -1
			}
		]
	},
	"skip": []
}
