{
	"id": "hooks/posttooluse-failure-hook",
	"area": "hooks",
	"argv": [
		"-p",
		"Run the probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose",
		"--include-hook-events",
		"--settings",
		"{\"hooks\":{\"PostToolUseFailure\":[{\"matcher\":\"Bash\",\"hooks\":[{\"type\":\"command\",\"command\":\"cat >> ev.jsonl; echo >> ev.jsonl\"}]}],\"PostToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"cat >> ev.jsonl; echo >> ev.jsonl\"}]}]}}",
		"--allowedTools",
		"Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "exit 3"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"files": [
			{
				"path": "ev.jsonl",
				"contains": [
					"\"hook_event_name\":\"PostToolUseFailure\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"exit 3\"},\"tool_use_id\":\"toolu_conformance_0_0\",\"error\":\"",
					"\",\"is_interrupt\":false,\"duration_ms\":"
				]
			}
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2,
				"index": -1
			}
		]
	},
	"skip": []
}
