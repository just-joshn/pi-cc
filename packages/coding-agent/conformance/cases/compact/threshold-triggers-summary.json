{
	"id": "compact/threshold-triggers-summary",
	"area": "compact",
	"argv": [
		"-p",
		"--model",
		"claude-sonnet-4-5",
		"--input-format",
		"stream-json",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
	},
	"stdin": {
		"kind": "stream-json",
		"lines": [
			"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"THRESHOLD_HISTORY\"}}",
			"#waitfor first reply",
			"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"BUILD_HISTORY\"}}",
			"#waitfor build reply",
			"{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"NEXT_TASK\"}}"
		]
	},
	"files": {},
	"model": {
		"turns": [
			{
				"text": "first reply"
			},
			{
				"sse": [
					{
						"type": "message_start",
						"message": {
							"id": "msg_usage",
							"type": "message",
							"role": "assistant",
							"model": "claude-sonnet-4-5",
							"content": [],
							"stop_reason": null,
							"stop_sequence": null,
							"usage": {
								"input_tokens": 170000,
								"output_tokens": 0
							}
						}
					},
					{
						"type": "content_block_start",
						"index": 0,
						"content_block": {
							"type": "text",
							"text": ""
						}
					},
					{
						"type": "content_block_delta",
						"index": 0,
						"delta": {
							"type": "text_delta",
							"text": "build reply"
						}
					},
					{
						"type": "content_block_stop",
						"index": 0
					},
					{
						"type": "message_delta",
						"delta": {
							"stop_reason": "end_turn",
							"stop_sequence": null
						},
						"usage": {
							"input_tokens": 170000,
							"cache_creation_input_tokens": 0,
							"cache_read_input_tokens": 0,
							"output_tokens": 8
						}
					},
					{
						"type": "message_stop"
					}
				]
			},
			{
				"text": "<summary>THRESHOLD_CHECKPOINT</summary>"
			},
			{
				"text": "done"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"method": "POST",
				"count": 4,
				"bodyAt": {
					"messages": {
						"match": [
							"THRESHOLD_CHECKPOINT",
							"NEXT_TASK"
						],
						"notMatch": [
							"THRESHOLD_HISTORY"
						]
					}
				}
			}
		]
	},
	"skip": []
}
