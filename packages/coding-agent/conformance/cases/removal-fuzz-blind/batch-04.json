{
	"id": "removal-fuzz-blind/batch-04",
	"area": "removal-fuzz-blind",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=\"*\" || rmdir ~; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X='' & rmdir ..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X='$HOME'; rmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(typeset X=\"*\" || rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X='$HOME' && rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=p04-fuzz-does-not-exist & rmdir $X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=p04-fuzz-does-not-exist && rmdir p04-fuzz-does-not-exist/..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=$HOME || rmdir $X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X=\"*\" | rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=$HOME || rmdir \"*\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=$HOME & rmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=p04-fuzz-does-not-exist || rmdir p04-fuzz-does-not-exist; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=.\nrmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=~ || rmdir '$X'`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "X=${HOME} & rmdir \"*\""
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X='$HOME' && rmdir /; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=~; rmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=\"*\" & rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X=$HOME & rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=/ || rmdir $HOME; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=\"$HOME\" | rmdir $HOME"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X=\\$HOME\nrmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=${HOME} && rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X=\\$HOME || rmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=..\nrmdir ..; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "export X=''; rmdir ."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(local X='$HOME' && rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(local X=$HOME; rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=..\nrmdir $X/usr`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X=/\nrmdir sub; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=p04-fuzz-does-not-exist && rmdir ..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X=/ & rmdir p04-fuzz-does-not-exist/..)"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
