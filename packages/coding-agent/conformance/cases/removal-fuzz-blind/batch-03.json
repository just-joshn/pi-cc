					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(export X=${HOME} && rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=$HOME || rmdir ..;; esac"
