					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=\\$HOME & rmdir ..; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X='$HOME' & rmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=$HOME\nrmdir \\$X"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X=/usr; rmdir \"$X\")"
