					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=sub || rmdir \\$X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X='' | rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=/ && rmdir *; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=\\$HOME || rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=\"$HOME\"; rmdir \"*\"; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=\"*\" & rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X='*' | rmdir ${X}/)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=\\$HOME && rmdir \\$X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(export X=.; rmdir /)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X=\"$HOME\" && rmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X='' | rmdir p04-fuzz-does-not-exist)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=p04-fuzz-does-not-exist | rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=/ && rmdir p04-fuzz-does-not-exist/..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X=~ && rmdir \\$X)"
