					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=~ | rmdir p04-fuzz-does-not-exist/..; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=/usr\nrmdir /; break; done"
