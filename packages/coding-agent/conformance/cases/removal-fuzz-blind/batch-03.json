					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=\"*\"; rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=sub && rmdir \\$X)"
