					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=\"$HOME\"\nrmdir p04-fuzz-does-not-exist/..; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=$HOME; rmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=\\$HOME | rmdir ${X}/"
