	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X='*'\nrmdir ..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=.; rmdir sub;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X='*'; rmdir \\$X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=sub || rmdir '$X'`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=${HOME}\nrmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X='*'\nrmdir $X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=''; rmdir ..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=\"$HOME\"; rmdir ${X}/)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=. || rmdir /; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=${HOME}\nrmdir p04-fuzz-does-not-exist)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X=${HOME} && rmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=$HOME && rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=$HOME | rmdir .)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=\\$HOME & rmdir '$X'; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X=/\nrmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X='*'\nrmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X=p04-fuzz-does-not-exist & rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=..\nrmdir p04-fuzz-does-not-exist/..`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=\\$HOME && rmdir .; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=\"*\"; rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=$HOME & rmdir '$X')\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "X=sub && rmdir \\$X"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(local X=.. && rmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=\"$HOME\" && rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { declare X=p04-fuzz-does-not-exist || rmdir /usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `X=\"*\"; rmdir $X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X=\"$HOME\" && rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X=~ || rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=''\nrmdir ~"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X='*' & rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=\"*\" || rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=sub || rmdir $HOME; }; true"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
