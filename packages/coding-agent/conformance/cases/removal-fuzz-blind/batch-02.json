{
	"id": "removal-fuzz-blind/batch-02",
	"area": "removal-fuzz-blind",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X='*'; rmdir \\$X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X='*' && rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(export X='*' && rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=$HOME || rmdir \\$X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=sub; rmdir /; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X=p04-fuzz-does-not-exist || rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=/ && rmdir /; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=.. | rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=$HOME & rmdir ~; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=~ && rmdir \"*\"; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X=.. | rmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=. || rmdir $X/usr; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X='$HOME' || rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do declare X=. || rmdir /; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X='$HOME'\nrmdir ${X}/)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X='*'\nrmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X=${HOME} | rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=/usr\nrmdir ~`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=.; rmdir $X/usr`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=p04-fuzz-does-not-exist && rmdir \"$X\"; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=~ && rmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X=p04-fuzz-does-not-exist || rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=$HOME || rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X='*' & rmdir $X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(local X=. | rmdir '$X')"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=/\nrmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=\"*\" | rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "export X=\"*\"\nrmdir sub/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=\"$HOME\" && rmdir $X/usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=sub; rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=sub | rmdir $X/usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=/ || rmdir p04-fuzz-does-not-exist/..)"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
