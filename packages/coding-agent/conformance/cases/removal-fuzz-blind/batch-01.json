{
	"id": "removal-fuzz-blind/batch-01",
	"area": "removal-fuzz-blind",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=\"*\" & rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X='*' & rmdir $X; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=sub; rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(local X=.. && rmdir $X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X='$HOME' || rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "export X='*'\nrmdir sub/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=\\$HOME & rmdir sub/..; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=~ && rmdir p04-fuzz-does-not-exist;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X=\"*\"\nrmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=sub; rmdir $X/usr`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=\"*\" && rmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=\"$HOME\" && rmdir sub/..`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X='*' && rmdir .`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X='*' || rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(typeset X=/usr && rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=${HOME} & rmdir \\$X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X='$HOME' | rmdir \"$X\""
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X='' & rmdir /usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X='*'\nrmdir /; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X=.. || rmdir '$X'; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X='$HOME' && rmdir $X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=\"$HOME\" | rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do local X=${HOME} || rmdir *; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=. & rmdir ${X}/`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X='$HOME' && rmdir sub"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=~ || rmdir p04-fuzz-does-not-exist`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=sub | rmdir $X/usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=${HOME} && rmdir ~; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=$HOME; rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=\"$HOME\" || rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=\"$HOME\"; rmdir /usr; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=/usr && rmdir $X"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
