{
	"id": "removal-fuzz-blind/batch-10",
	"area": "removal-fuzz-blind",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true <(X='$HOME'\nrmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X='$HOME' & rmdir ~`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=..\nrmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(export X='$HOME'\nrmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(export X=sub && rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=~; rmdir '$X';; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=$HOME; rmdir sub/..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X=${HOME} & rmdir ~; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X=/ || rmdir /"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=$HOME & rmdir /; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { declare X=..\nrmdir /; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X=sub | rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X=/usr & rmdir /; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=/usr & rmdir .)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X=\\$HOME | rmdir \\$X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=\"$HOME\" || rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X='$HOME' | rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=~ && rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(export X='*' | rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=..; rmdir p04-fuzz-does-not-exist`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=\"*\"\nrmdir *"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=.. | rmdir ."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=~ || rmdir ${X}/)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(export X=sub & rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then local X=\"$HOME\"; rmdir /; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X=p04-fuzz-does-not-exist && rmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=.. | rmdir ."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X='*' && rmdir ..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=''\nrmdir ${X}/; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=sub; rmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X='' && rmdir p04-fuzz-does-not-exist/..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=/ | rmdir .; }"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
