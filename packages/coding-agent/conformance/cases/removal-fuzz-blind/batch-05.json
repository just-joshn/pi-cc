{
	"id": "removal-fuzz-blind/batch-05",
	"area": "removal-fuzz-blind",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=\"*\" || rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=\"$HOME\" | rmdir $X; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=$HOME && rmdir \"*\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=${HOME} && rmdir .; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=sub || rmdir \"*\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X=\"$HOME\" | rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X=/ || rmdir *; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X=sub & rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X='*' && rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=/ | rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=$HOME\nrmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(local X=. | rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(typeset X='*' && rmdir sub)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=p04-fuzz-does-not-exist && rmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X='*' & rmdir \"$X\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=.. && rmdir ~`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=sub || rmdir \"$X\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=.. && rmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=${HOME} || rmdir sub`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=${HOME} && rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X=${HOME} & rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=/usr; rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=sub && rmdir $X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X=~ | rmdir sub/..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(local X=/ || rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X='$HOME' & rmdir *;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=~ || rmdir '$X'"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "export X=$HOME; rmdir \"$X\""
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X=/usr; rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=p04-fuzz-does-not-exist\nrmdir .; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=. | rmdir sub/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=~ & rmdir $X; done"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
