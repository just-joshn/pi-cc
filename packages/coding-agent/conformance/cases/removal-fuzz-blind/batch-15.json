					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=''\nrmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=p04-fuzz-does-not-exist || rmdir $X/usr)"
