					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X='*' | rmdir \\$X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=p04-fuzz-does-not-exist | rmdir *; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X='' || rmdir $HOME)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=~ || rmdir p04-fuzz-does-not-exist`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=\"*\" || rmdir $HOME)\nEOF"
