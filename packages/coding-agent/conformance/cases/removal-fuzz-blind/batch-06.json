{
	"id": "removal-fuzz-blind/batch-06",
	"area": "removal-fuzz-blind",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=$HOME || rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=${HOME} | rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=\\$HOME && rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=${HOME} && rmdir .."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=~ || rmdir '$X')"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X='*' | rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=p04-fuzz-does-not-exist | rmdir sub/..`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X='*'; rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X='*'; rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=\\$HOME || rmdir ~; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X='$HOME' && rmdir \"$X\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=.. && rmdir ~; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do local X=''\nrmdir \"$X\"; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X='$HOME' | rmdir ..; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X=..; rmdir p04-fuzz-does-not-exist;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X='$HOME' | rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=/usr | rmdir ..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=\"$HOME\" | rmdir sub)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=~ || rmdir ..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=/usr & rmdir $X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X='$HOME'; rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X=.; rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X=.\nrmdir ${X}/; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X='*'\nrmdir $X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X='*' & rmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=p04-fuzz-does-not-exist || rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=\"$HOME\" & rmdir p04-fuzz-does-not-exist; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=/ & rmdir ..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(export X=/usr & rmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=/\nrmdir '$X'; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=.\nrmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X='$HOME' | rmdir /; break; done"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
