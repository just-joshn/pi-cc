{
	"id": "removal-fuzz-holdout/batch-14",
	"area": "removal-fuzz-holdout",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=~ && rmdir $HOME; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X=.. || rmdir '$X')\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=${HOME} | rmdir /usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=/usr | rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X='' | rmdir /; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=.. | rmdir p04-fuzz-does-not-exist/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X='' & rmdir sub/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X='$HOME' || rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=${HOME}; rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(typeset X=\"*\" & rmdir /)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X='*'; rmdir $X; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X='*'\nrmdir p04-fuzz-does-not-exist/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=sub\nrmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=/usr; rmdir '$X';; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=sub & rmdir p04-fuzz-does-not-exist; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=p04-fuzz-does-not-exist & rmdir '$X'; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(local X=/\nrmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X='$HOME'; rmdir \"$X\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X=. & rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=. | rmdir /usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=~ | rmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { declare X=/ | rmdir ..; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(typeset X=sub | rmdir $X/usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=/usr & rmdir .."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=/ & rmdir /usr; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=\"*\" || rmdir sub/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(typeset X=p04-fuzz-does-not-exist && rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X=/ & rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=p04-fuzz-does-not-exist && rmdir $X/usr; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=\"*\" && rmdir *`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=. & rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X=.. & rmdir sub/..)"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
