	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=sub & rmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=/usr & rmdir \"$X\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=..\nrmdir $X/usr"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=/ || rmdir $X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=$HOME & rmdir /usr"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=/usr; rmdir *; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=$HOME && rmdir ..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X='$HOME'; rmdir ~; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=~ && rmdir sub/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X=/ && rmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X=${HOME} & rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X=~\nrmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=~ || rmdir \"$X\"`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=${HOME} && rmdir p04-fuzz-does-not-exist)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X='*' && rmdir /; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X='$HOME'\nrmdir \\$X"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do local X=${HOME}\nrmdir /; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X=. & rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X=sub | rmdir ${X}/;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X='*' | rmdir /`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X=..\nrmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=. | rmdir $HOME; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(local X=\"$HOME\" && rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X='$HOME'\nrmdir $X/usr; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=$HOME && rmdir \\$X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X='' & rmdir p04-fuzz-does-not-exist; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X=$HOME; rmdir \\$X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=/\nrmdir /`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=~; rmdir $X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(typeset X=\"$HOME\"; rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=${HOME} | rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=\"*\" & rmdir ~; }"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
