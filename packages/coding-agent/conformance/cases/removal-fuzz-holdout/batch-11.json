{
	"id": "removal-fuzz-holdout/batch-11",
	"area": "removal-fuzz-holdout",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
