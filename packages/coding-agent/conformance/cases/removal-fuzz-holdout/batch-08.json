					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=\\$HOME; rmdir $X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=. || rmdir /usr; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=~ || rmdir sub/..`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X=$HOME && rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=\"$HOME\" && rmdir ..; }"
						}
					}
				]
