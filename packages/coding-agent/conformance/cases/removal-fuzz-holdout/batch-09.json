{
	"id": "removal-fuzz-holdout/batch-09",
	"area": "removal-fuzz-holdout",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true `X=\"$HOME\"; rmdir \\$X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X='$HOME' & rmdir ~; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=~ & rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=$HOME && rmdir \\$X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=/usr || rmdir .`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=\"$HOME\"; rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X=\"$HOME\" && rmdir '$X';; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=.; rmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=''; rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=\"*\" && rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ declare X=p04-fuzz-does-not-exist\nrmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=. || rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=~; rmdir \"$X\"`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X='*'\nrmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X='*' && rmdir .; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=. | rmdir '$X')\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X='$HOME'; rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=\"$HOME\"; rmdir p04-fuzz-does-not-exist/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=${HOME} & rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X=$HOME | rmdir *; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X='' || rmdir \"*\"`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X='' || rmdir p04-fuzz-does-not-exist; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=..\nrmdir /)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=.. && rmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X=${HOME} || rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=sub\nrmdir p04-fuzz-does-not-exist)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=sub || rmdir .)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X=p04-fuzz-does-not-exist && rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=. || rmdir '$X';; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=$HOME && rmdir p04-fuzz-does-not-exist/..`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X='*' && rmdir \"$X\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=''\nrmdir /; break; done"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
