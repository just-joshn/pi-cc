{
	"id": "removal-fuzz-holdout/batch-10",
	"area": "removal-fuzz-holdout",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=''; rmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "X=p04-fuzz-does-not-exist\nrmdir $X"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=$HOME & rmdir $X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X=sub & rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=${HOME} | rmdir ..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=$HOME\nrmdir *`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X='$HOME' || rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=\"*\" || rmdir \\$X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X=/\nrmdir ${X}/"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=$HOME; rmdir $X/usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=\"*\"\nrmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X=. || rmdir /usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=\"$HOME\" && rmdir $X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `X=.; rmdir $X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=${HOME} | rmdir \\$X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=sub & rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X='' | rmdir .;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X=~ | rmdir \"$X\"; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=\\$HOME && rmdir $X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X=/ || rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=\"$HOME\"\nrmdir ~; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=.. || rmdir p04-fuzz-does-not-exist"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=$HOME & rmdir \"*\"`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=/usr || rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=p04-fuzz-does-not-exist\nrmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X=/usr || rmdir p04-fuzz-does-not-exist/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=''; rmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=\"*\" || rmdir \\$X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=\"$HOME\" && rmdir '$X'`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X='*' || rmdir $X/usr"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=\\$HOME & rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X='' | rmdir $X/usr; }"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
