					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=\\$HOME | rmdir \\$X; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X='$HOME' && rmdir \"*\"; }"
