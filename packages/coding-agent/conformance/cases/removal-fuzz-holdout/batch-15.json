					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=sub\nrmdir /)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=${HOME} & rmdir ${X}/; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=$HOME\nrmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X=sub & rmdir /)"
