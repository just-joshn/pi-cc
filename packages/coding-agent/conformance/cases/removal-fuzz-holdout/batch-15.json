					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(typeset X=\"*\"; rmdir sub)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=\"$HOME\" || rmdir $X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X='' || rmdir $X; }"
