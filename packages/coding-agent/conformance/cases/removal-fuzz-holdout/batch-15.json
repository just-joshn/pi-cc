					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=${HOME} | rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X=/; rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=\\$HOME\nrmdir .)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=${HOME} & rmdir p04-fuzz-does-not-exist/..)"
