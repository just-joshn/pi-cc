{
	"id": "removal-fuzz-holdout/batch-03",
	"area": "removal-fuzz-holdout",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X=~ || rmdir ..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=p04-fuzz-does-not-exist\nrmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=p04-fuzz-does-not-exist; rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X=p04-fuzz-does-not-exist; rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=sub\nrmdir \"*\"; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=\\$HOME; rmdir ..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=\"$HOME\" || rmdir ~)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=. & rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=~ & rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=\\$HOME; rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=p04-fuzz-does-not-exist\nrmdir p04-fuzz-does-not-exist;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=$HOME\nrmdir ${X}/`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X=${HOME} || rmdir ~"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { declare X=sub; rmdir p04-fuzz-does-not-exist; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X=\"*\"\nrmdir ..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X=~\nrmdir /usr"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=\"$HOME\"; rmdir ..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X='*'\nrmdir sub/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then local X=. && rmdir sub; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X='$HOME' || rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=\"*\"; rmdir ..; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=/; rmdir sub/..`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(export X=/; rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(local X=\"*\"; rmdir $X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=${HOME} && rmdir $X/usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X=/usr; rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=/usr | rmdir '$X'"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=/; rmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X='*'\nrmdir \"$X\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=\"*\"; rmdir .."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X=\"*\" || rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X='*' && rmdir sub; }; true"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
