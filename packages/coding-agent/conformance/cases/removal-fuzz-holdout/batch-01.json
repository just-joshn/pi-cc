{
	"id": "removal-fuzz-holdout/batch-01",
	"area": "removal-fuzz-holdout",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=\"*\" | rmdir ~; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=$HOME && rmdir p04-fuzz-does-not-exist/..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=/\nrmdir sub/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=.. | rmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=\"*\"\nrmdir $HOME)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=\"$HOME\" && rmdir $HOME; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X=/usr\nrmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=\"*\" || rmdir ..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=~ & rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=$HOME | rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X='*' && rmdir p04-fuzz-does-not-exist; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=~; rmdir $HOME; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=..; rmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X=$HOME & rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=p04-fuzz-does-not-exist | rmdir p04-fuzz-does-not-exist; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=''\nrmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=\\$HOME\nrmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=p04-fuzz-does-not-exist && rmdir ~; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X=\"$HOME\" || rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=\"$HOME\" | rmdir sub)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(typeset X=\"*\" || rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=${HOME} || rmdir \"*\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X=\\$HOME | rmdir '$X'; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=\\$HOME\nrmdir $HOME; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "X=sub | rmdir \\$X"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=..; rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X=\\$HOME | rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(local X=~ && rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=sub | rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=\\$HOME; rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=$HOME | rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=/ & rmdir /; fi"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
