{
	"id": "removal-fuzz-holdout/batch-02",
	"area": "removal-fuzz-holdout",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=$HOME && rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X=\\$HOME || rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=$HOME; rmdir p04-fuzz-does-not-exist/..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X='' || rmdir \\$X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=sub\nrmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(local X=p04-fuzz-does-not-exist\nrmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=\\$HOME || rmdir p04-fuzz-does-not-exist; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X=/usr && rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(local X=sub || rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(typeset X=sub & rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=p04-fuzz-does-not-exist; rmdir '$X'; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=\"*\"; rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X=\"$HOME\"; rmdir /; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X=\"*\" & rmdir $X/usr;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X='' | rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=.. && rmdir \\$X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=.. | rmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(export X='*' & rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=/; rmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(typeset X=p04-fuzz-does-not-exist & rmdir /)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=\\$HOME | rmdir '$X'; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(typeset X=$HOME | rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=$HOME || rmdir ${X}/; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `X=p04-fuzz-does-not-exist || rmdir .`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=/ & rmdir $X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=. && rmdir sub/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=\"$HOME\"\nrmdir ~; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X=/ || rmdir '$X'; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=p04-fuzz-does-not-exist\nrmdir $X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=p04-fuzz-does-not-exist | rmdir $HOME)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=.; rmdir /; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=\"$HOME\" || rmdir $X/usr)\nEOF"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
