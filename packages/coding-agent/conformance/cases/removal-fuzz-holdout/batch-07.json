{
	"id": "removal-fuzz-holdout/batch-07",
	"area": "removal-fuzz-holdout",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=/usr | rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X='' && rmdir $HOME; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=${HOME} && rmdir $HOME; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=\"*\"\nrmdir \\$X"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X=\"$HOME\" && rmdir /"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=\\$HOME && rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=/ & rmdir p04-fuzz-does-not-exist/..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X=..; rmdir /usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X='*' & rmdir sub/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X='' & rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X='*' && rmdir p04-fuzz-does-not-exist"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X='' || rmdir $X/usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=\\$HOME & rmdir ~)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do local X=\"$HOME\" || rmdir p04-fuzz-does-not-exist; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=..\nrmdir sub/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=\\$HOME && rmdir ${X}/`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(export X=p04-fuzz-does-not-exist | rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "X=p04-fuzz-does-not-exist & rmdir sub/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=\"$HOME\"; rmdir p04-fuzz-does-not-exist; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=..\nrmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X='$HOME' && rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X='*' & rmdir sub/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=sub; rmdir \"$X\""
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=/; rmdir sub/..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=\"*\" || rmdir $HOME; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X=/usr || rmdir /usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=sub | rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=\\$HOME && rmdir .; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(typeset X=\"*\"\nrmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=\"*\" && rmdir $X/usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=/usr || rmdir sub; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=~ | rmdir $X;; esac"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
