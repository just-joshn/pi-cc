{
	"id": "removal-fuzz-holdout/batch-04",
	"area": "removal-fuzz-holdout",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true $(X='$HOME' | rmdir '$X')"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X=${HOME} & rmdir '$X'; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=${HOME} && rmdir \"*\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=p04-fuzz-does-not-exist | rmdir \"$X\";; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=.\nrmdir ${X}/)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=~\nrmdir sub)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=/usr && rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=sub; rmdir ~; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X=sub && rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=.. || rmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X='$HOME' & rmdir $HOME;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X=/usr && rmdir '$X'; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X='' | rmdir \"$X\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=..\nrmdir sub"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=/\nrmdir /;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=p04-fuzz-does-not-exist\nrmdir $HOME; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=p04-fuzz-does-not-exist; rmdir $HOME; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { declare X='$HOME' && rmdir p04-fuzz-does-not-exist; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(local X=p04-fuzz-does-not-exist\nrmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=sub || rmdir p04-fuzz-does-not-exist; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do local X=\\$HOME; rmdir \\$X; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X='$HOME'; rmdir .)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X=/ | rmdir \"*\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=.. & rmdir $X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X=..; rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=sub & rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=$HOME\nrmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=p04-fuzz-does-not-exist && rmdir ~; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X=p04-fuzz-does-not-exist & rmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=/ || rmdir sub)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=$HOME && rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=p04-fuzz-does-not-exist | rmdir /usr; break; done"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
