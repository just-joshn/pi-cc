					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=\\$HOME & rmdir $HOME)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=/usr && rmdir sub`"
