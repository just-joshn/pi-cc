					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=\\$HOME | rmdir $X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X=. || rmdir p04-fuzz-does-not-exist;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=${HOME}; rmdir p04-fuzz-does-not-exist/..)"
