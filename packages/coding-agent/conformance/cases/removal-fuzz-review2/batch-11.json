					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=${HOME}; rmdir /; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=. && rmdir \"*\")\nEOF"
