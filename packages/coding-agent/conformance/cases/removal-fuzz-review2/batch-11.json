					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=sub\nrmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X=~; rmdir p04-fuzz-does-not-exist)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=/usr || rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X='' && rmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X='*' | rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=${HOME} && rmdir p04-fuzz-does-not-exist/..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=/usr || rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X='*' && rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=sub & rmdir \"$X\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=.. | rmdir \\$X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { declare X=/ | rmdir \"$X\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X=p04-fuzz-does-not-exist || rmdir /)\nEOF"
