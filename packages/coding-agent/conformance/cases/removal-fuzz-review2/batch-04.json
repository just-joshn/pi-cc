{
	"id": "removal-fuzz-review2/batch-04",
	"area": "removal-fuzz-review2",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "(export X=. || rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=.; rmdir /; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=p04-fuzz-does-not-exist | rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X='*'; rmdir $X/usr; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X=\\$HOME\nrmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=\"*\" && rmdir $HOME;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(local X=~ & rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=. | rmdir sub/..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=.. || rmdir sub/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X=\\$HOME; rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=/usr; rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=sub & rmdir ${X}/;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=/usr | rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X=\\$HOME & rmdir '$X'; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X=''; rmdir sub/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=/ | rmdir .; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X=..; rmdir ..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=sub; rmdir ${X}/)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=/ | rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=/\nrmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=~; rmdir sub; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=~ && rmdir /; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X=p04-fuzz-does-not-exist | rmdir \"$X\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(typeset X=sub & rmdir \\$X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=/usr || rmdir *; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=\\$HOME | rmdir '$X')"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=${HOME}\nrmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(export X=p04-fuzz-does-not-exist & rmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=/usr | rmdir ~"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(export X=\"$HOME\" || rmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do local X=\"$HOME\"\nrmdir p04-fuzz-does-not-exist/..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X=''\nrmdir ${X}/)"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
