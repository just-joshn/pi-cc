{
	"id": "removal-fuzz-review2/batch-03",
	"area": "removal-fuzz-review2",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=/usr && rmdir $X/usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=\"$HOME\" && rmdir '$X';; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=/ | rmdir p04-fuzz-does-not-exist)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X=. & rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=p04-fuzz-does-not-exist || rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=sub & rmdir ${X}/)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=/usr || rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=\\$HOME && rmdir p04-fuzz-does-not-exist/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=\\$HOME && rmdir *; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=.. || rmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=/; rmdir .; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=/; rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X='*' || rmdir .;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X='$HOME'; rmdir '$X'; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=''; rmdir \"$X\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=/usr & rmdir $X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=. || rmdir /; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=/\nrmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then local X=\"*\"; rmdir .; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=p04-fuzz-does-not-exist && rmdir sub/..`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do declare X=$HOME\nrmdir p04-fuzz-does-not-exist; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=. | rmdir ${X}/)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `X=.. || rmdir .`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=/; rmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=sub; rmdir sub/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=${HOME}\nrmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X='' | rmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X=''\nrmdir sub; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X='' && rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=/usr\nrmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "X=\"$HOME\" | rmdir ~"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=sub & rmdir /; }"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
