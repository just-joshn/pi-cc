					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=${HOME}; rmdir .; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X='*' && rmdir $HOME; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X='$HOME' || rmdir ~"
