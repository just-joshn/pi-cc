					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=. && rmdir $HOME; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=$HOME && rmdir '$X')\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X='*' || rmdir \"$X\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=\\$HOME\nrmdir sub;; esac"
