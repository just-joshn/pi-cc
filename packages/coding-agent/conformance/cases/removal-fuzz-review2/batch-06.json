					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=/ & rmdir /)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(export X=${HOME} && rmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=. & rmdir /"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=~\nrmdir \"$X\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=${HOME} & rmdir /usr; done"
