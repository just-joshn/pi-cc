{
	"id": "removal-fuzz-review2/batch-00",
	"area": "removal-fuzz-review2",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=\\$HOME | rmdir /usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(export X=${HOME} || rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X='*' && rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X=/usr\nrmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X='' | rmdir $X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=\\$HOME && rmdir \"$X\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=\\$HOME & rmdir $X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=/usr | rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=sub & rmdir $X/usr;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=..\nrmdir ..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=/usr || rmdir \"*\"`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=\"*\"; rmdir ${X}/`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X=~ || rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X='' & rmdir $HOME`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=\"$HOME\"; rmdir ..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ declare X='*'\nrmdir p04-fuzz-does-not-exist; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "X='' | rmdir p04-fuzz-does-not-exist/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=p04-fuzz-does-not-exist || rmdir \"$X\"`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=sub && rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=.\nrmdir $X/usr;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do declare X='*' & rmdir ..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X=sub & rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=$HOME; rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=.; rmdir ~)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=..\nrmdir *`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=sub & rmdir sub/..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=p04-fuzz-does-not-exist; rmdir sub)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X='*' | rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=..; rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=/ & rmdir /)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "export X=${HOME}\nrmdir \\$X"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=\"*\" | rmdir .;; esac"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
