{
	"id": "removal-fuzz-review2/batch-01",
	"area": "removal-fuzz-review2",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=sub && rmdir /; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=/usr; rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=. && rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X=\"*\"; rmdir /"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=..; rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=/; rmdir \"$X\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X=p04-fuzz-does-not-exist || rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=/ && rmdir ~; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ declare X=/; rmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=. & rmdir sub; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=\"*\" && rmdir *; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X=p04-fuzz-does-not-exist && rmdir p04-fuzz-does-not-exist; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=$HOME || rmdir \\$X"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(local X=~ | rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do declare X='' || rmdir *; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=\"$HOME\" & rmdir \"$X\"; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(local X=/usr | rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X=/usr && rmdir ~)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=/ && rmdir $X/usr`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=.; rmdir /;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X=~\nrmdir *; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X='$HOME' || rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=..\nrmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=${HOME} || rmdir *"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=${HOME} & rmdir ..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=\"$HOME\" | rmdir ~"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=p04-fuzz-does-not-exist && rmdir \\$X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X=/usr && rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X='$HOME'; rmdir \"*\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X=..; rmdir ..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=sub | rmdir ~; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(typeset X=$HOME && rmdir *)"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
