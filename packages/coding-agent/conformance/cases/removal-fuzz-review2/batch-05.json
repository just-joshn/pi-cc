	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "(X='*' | rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=${HOME}\nrmdir \"*\"; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=..\nrmdir \"$X\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X=~\nrmdir \"*\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=. | rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=p04-fuzz-does-not-exist; rmdir $X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(export X='*'\nrmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=p04-fuzz-does-not-exist || rmdir /`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X='$HOME' || rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X=\"*\" & rmdir $HOME;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X=~\nrmdir '$X'; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X=.\nrmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=\\$HOME || rmdir ..; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X='*' || rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=\\$HOME\nrmdir \"*\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=. | rmdir sub/..; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=\"*\"; rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=\"*\" & rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=~ & rmdir p04-fuzz-does-not-exist`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X=/usr || rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=/ & rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X='' | rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=\"*\"; rmdir *; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(local X=. | rmdir $X/usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=/ && rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=.. | rmdir .; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X=~\nrmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X=.. && rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X='$HOME' || rmdir ~; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=/ | rmdir /usr; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X=$HOME\nrmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(declare X=.. | rmdir ${X}/)"
						}
					}
