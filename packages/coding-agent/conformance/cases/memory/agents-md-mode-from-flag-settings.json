{
	"id": "memory/agents-md-mode-from-flag-settings",
	"area": "memory",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--settings",
		"{\"pluginConfigs\": {\"cc-plugin-agents-md@builtin\": {\"options\": {\"instructionFiles\": \"claude-md\"}}}}"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"AGENTS.md": "AG_ROOT\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"bodyAt": {
					"messages": {
						"notMatch": [
							"AG_ROOT"
						]
					},
					"system": {
						"notMatch": [
							"AG_ROOT"
						]
					}
				}
			}
		]
	},
	"skip": []
}
