{
	"id": "memory/nested-memory-deduped-haiku-4-5",
	"area": "memory",
	"argv": [
		"-p",
		"Read the fixtures",
		"--model",
		"claude-haiku-4-5"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"sub/CLAUDE.md": "CL_SUB\n",
		"sub/x.txt": "x\n",
		"sub/y.txt": "y\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "sub/x.txt"
					}
				}
			},
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "sub/y.txt"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"files": [],
		"requests": [
			{
				"pathStartsWith": "/v1/messages?",
				"count": 3,
				"bodyMatch": [
					"\"content\":\"[^\"]*\\\\n\\\\n<system-reminder>\\\\nContents of [^\"]*/workspace/sub/CLAUDE\\.md:\\\\n\\\\nCL_SUB\\\\n\\\\n</system-reminder>"
				],
				"bodyNotMatch": [
					"\"role\":\"user\",\"content\":\\[\\{\"type\":\"text\",\"text\":\"<system-reminder>\\\\nContents of",
					"\"role\":\"system\",\"content\":(?:\"|\\[\\{\"type\":\"text\",\"text\":\")[^\"]*Contents of",
					"\"type\":\"text\",\"text\":\"<system-reminder>\\\\nContents of",
					"(CL_SUB[\\s\\S]*){2}"
				]
			}
		]
	},
	"skip": []
}
