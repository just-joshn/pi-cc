{
	"id": "memory/bare-skips-memory",
	"area": "memory",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--bare"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"$CONFIG/CLAUDE.md": "USER_B\n",
		"CLAUDE.md": "PROJECT_B\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"bodyAt": {
					"messages.0": {
						"notMatch": [
							"Contents of",
							"_B\\b"
						]
					},
					"system": {
						"notMatch": [
							"USER_B|PROJECT_B"
						]
					}
				}
			}
		]
	},
	"skip": []
}
