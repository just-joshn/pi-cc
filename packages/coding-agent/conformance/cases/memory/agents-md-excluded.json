{
	"id": "memory/agents-md-excluded",
	"area": "memory",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"$CONFIG/settings.json": "{\"claudeMdExcludes\": [\"$WORKSPACE/AGENTS.md\"]}\n",
		"AGENTS.md": "AG_ROOT\n",
		".claude/AGENTS.md": "AG_DOT\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"bodyAt": {
					"messages": {
						"notMatch": [
							"AG_ROOT"
						]
					},
					"system": {
						"notMatch": [
							"AG_ROOT"
						]
					},
					"messages.0.content.0.text": {
						"match": [
							"Contents of [^\\n]*/workspace/\\.claude/AGENTS\\.md (\\([^\\n]*\\)):\\n\\nAG_DOT\\n</system-reminder>$"
						]
					}
				}
			}
		]
	},
	"skip": []
}
