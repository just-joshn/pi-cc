{
	"id": "memory/agents-md-unloaded-claude-md-does-not-count",
	"area": "memory",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"$CONFIG/settings.json": "{\"claudeMdExcludes\": [\"$WORKSPACE/CLAUDE.md\"]}\n",
		"CLAUDE.md": "CL_EXCLUDED\n",
		".claude/CLAUDE.md": "<!-- only a comment -->\n",
		"AGENTS.md": "AG_ROOT\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"bodyAt": {
					"messages.0.content.0.text": {
						"match": [
							"Contents of [^\\n]*/workspace/AGENTS\\.md (\\([^\\n]*\\)):\\n\\nAG_ROOT\\n</system-reminder>$"
						]
					},
					"messages": {
						"notMatch": [
							"CL_EXCLUDED"
						]
					},
					"system": {
						"notMatch": [
							"CL_EXCLUDED"
						]
					}
				}
			}
		]
	},
	"skip": []
}
