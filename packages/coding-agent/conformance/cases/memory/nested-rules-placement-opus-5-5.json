					"\\},\\{\"type\":\"text\",\"text\":\"<system-reminder>\\\\nContents of [^\"]*/workspace/r/\\.claude/rules/cond\\.md:\\\\n\\\\nRULE_COND\\\\n\\\\n</system-reminder>(?:\\\\n)?\"(?:,\"cache_control\":\\{[^}]*\\})?\\}"
				],
