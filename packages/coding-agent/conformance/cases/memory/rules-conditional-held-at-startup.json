{
	"id": "memory/rules-conditional-held-at-startup",
	"area": "memory",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"CLAUDE.md": "PROJ\n",
		".claude/rules/always.md": "RULE_ALWAYS\n",
		".claude/rules/ts.md": "---\npaths:\n  - \"src/**/*.ts\"\n---\nRULE_SCOPED_TS\n",
		".claude/rules/md.md": "---\npaths: lib/*.md\n---\nRULE_SCOPED_MD\n",
		"src/a.ts": "export const a = 1;\n",
		"sub/CLAUDE.md": "NESTED_MEMO\n",
		"sub/deeper/x.txt": "x\n",
		"sub/deeper/CLAUDE.local.md": "NESTED_LOCAL\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"bodyAt": {
					"messages.0.content.0.text": {
						"match": [
							"Contents of [^\\n]*/workspace/\\.claude/rules/always\\.md \\([^\\n]*\\):\\n\\nRULE_ALWAYS"
						],
						"notMatch": [
							"RULE_SCOPED",
							"NESTED_"
						]
					}
				}
			}
		]
	},
	"skip": []
}
