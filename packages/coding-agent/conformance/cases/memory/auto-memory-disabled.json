{
	"id": "memory/auto-memory-disabled",
	"area": "memory",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"$CONFIG/settings.json": "{\"autoMemoryDirectory\": \"$TMP/am\", \"autoMemoryEnabled\": false}\n",
		"$TMP/am/MEMORY.md": "AM_OFF\n",
		"CLAUDE.md": "PROJ_ON\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"bodyAt": {
					"messages.0.content.0.text": {
						"match": [
							"PROJ_ON"
						],
						"notMatch": [
							"AM_OFF"
						]
					},
					"system": {
						"notMatch": [
							"/tmp/am"
						]
					}
				}
			}
		]
	},
	"skip": []
}
