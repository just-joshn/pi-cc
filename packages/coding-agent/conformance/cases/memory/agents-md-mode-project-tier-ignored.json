{
	"id": "memory/agents-md-mode-project-tier-ignored",
	"area": "memory",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		".claude/settings.json": "{\"pluginConfigs\": {\"cc-plugin-agents-md@builtin\": {\"options\": {\"instructionFiles\": \"claude-md\"}}}}\n",
		"AGENTS.md": "AG_ROOT\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"bodyAt": {
					"messages.0.content.0.text": {
						"match": [
							"Contents of [^\\n]*/workspace/AGENTS\\.md (\\([^\\n]*\\)):\\n\\nAG_ROOT\\n</system-reminder>$"
						]
					}
				}
			}
		]
	},
	"skip": []
}
