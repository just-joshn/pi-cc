{
	"id": "memory/nested-claude-md-placement-opus-5-5",
	"area": "memory",
	"argv": [
		"-p",
		"Read the fixtures",
		"--model",
		"claude-opus-5-5"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"sub/CLAUDE.md": "CL_SUB\n",
		"sub/x.txt": "x\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "sub/x.txt"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages?",
				"count": 2,
				"bodyMatch": [
					"CL_SUB",
					"\\},\\{\"type\":\"text\",\"text\":\"<system-reminder>\\\\nContents of [^\"]*/workspace/sub/CLAUDE\\.md:\\\\n\\\\nCL_SUB\\\\n\\\\n</system-reminder>\"(?:,\"cache_control\":\\{[^}]*\\})?\\}"
				],
				"bodyNotMatch": [
					"\"content\":\"[^\"]*Contents of [^\"]*CL_SUB",
					"\"role\":\"system\",\"content\":\"[^\"]*CL_SUB",
					"\"role\":\"system\",\"content\":\\[\\{\"type\":\"text\",\"text\":\"<system-reminder>\\\\nContents of"
				]
			}
		]
	},
	"skip": []
}
