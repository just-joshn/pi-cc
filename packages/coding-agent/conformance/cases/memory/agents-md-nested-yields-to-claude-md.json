{
	"id": "memory/agents-md-nested-yields-to-claude-md",
	"area": "memory",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"CLAUDE.md": "CL_ROOT\n",
		"AGENTS.md": "AG_ROOT\n",
		"sub/AGENTS.md": "AG_SUB\n",
		"sub/x.txt": "x\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Read",
						"input": {
							"file_path": "sub/x.txt"
						}
					}
				]
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2,
				"bodyAt": {
					"messages": {
						"match": [
							"CL_ROOT"
						],
						"notMatch": [
							"AG_"
						]
					}
				}
			}
		]
	},
	"skip": []
}
