{
	"id": "memory/text-comment-line-dropped",
	"area": "memory",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"CLAUDE.md": "C1\n<!-- c -->\nC2\n\n<!-- d --> kept\nC3\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"bodyAt": {
					"messages.0.content.0.text": {
						"match": [
							"Contents of [^\\n]*/workspace/CLAUDE\\.md (\\([^\\n]*\\)):\\n\\nC1\\nC2\\n\\n kept\\nC3\\n</system-reminder>$"
						]
					}
				}
			}
		]
	},
	"skip": []
}
