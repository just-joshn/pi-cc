{
	"id": "memory/nested-memory-on-edit-opus-5-5",
	"area": "memory",
	"argv": [
		"-p",
		"Read the fixtures",
		"--model",
		"claude-opus-5-5",
		"--permission-mode",
		"acceptEdits"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$AGENT/trust.json": "{\"$WORKSPACE\": true}\n",
		"sub/CLAUDE.md": "EDIT_MEMORY\n",
		"sub/edit.txt": "before\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Edit",
					"input": {
						"file_path": "sub/edit.txt",
						"old_string": "before",
						"new_string": "after"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"files": [
			"sub/edit.txt"
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages?",
				"count": 2,
				"bodyMatch": [
					"\"type\":\"tool_result\"[^\\n]*updated successfully[\\s\\S]*\\},\\{\"type\":\"text\",\"text\":\"<system-reminder>\\\\nContents of [^\"]*/workspace/sub/CLAUDE\\.md:\\\\n\\\\nEDIT_MEMORY\\\\n\\\\n</system-reminder>(?:\\\\n)?\"(?:,\"cache_control\":\\{[^}]*\\})?\\}"
				],
				"bodyNotMatch": [
					"\"content\":\"[^\"]*Contents of",
					"\"role\":\"system\",\"content\":(?:\"|\\[\\{\"type\":\"text\",\"text\":\")[^\"]*Contents of",
					"\"type\":\"text\",\"text\":\"Contents of",
					"(EDIT_MEMORY[\\s\\S]*){2}"
				]
			}
		]
	},
	"skip": []
}
