{
	"id": "removal-fuzz-review1/batch-02",
	"area": "removal-fuzz-review1",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X='$HOME'; rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X='$HOME' || rmdir ${X}/; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X='$HOME'; rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=~\nrmdir ..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=\"$HOME\" && rmdir ..`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X='*'; rmdir '$X';; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X=. && rmdir \"$X\";; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=\"*\" || rmdir p04-fuzz-does-not-exist"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do declare X=.. & rmdir \\$X; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=\"$HOME\" | rmdir $X/usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X='$HOME' | rmdir /usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=p04-fuzz-does-not-exist & rmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X='' || rmdir p04-fuzz-does-not-exist;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X=${HOME} | rmdir /;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X=\\$HOME | rmdir '$X')"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X=/usr; rmdir $X/usr; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=\"*\" || rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=/usr; rmdir ${X}/; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then local X=\"$HOME\" | rmdir \"$X\"; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=/ && rmdir p04-fuzz-does-not-exist)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=sub || rmdir sub; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=/usr | rmdir /; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=..\nrmdir sub; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=${HOME}\nrmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `X=~ && rmdir \"*\"`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X='' && rmdir '$X'"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=/usr\nrmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=$HOME | rmdir p04-fuzz-does-not-exist)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=\"$HOME\" | rmdir /)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=.. && rmdir '$X')"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(typeset X=sub && rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=/usr & rmdir '$X')"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
