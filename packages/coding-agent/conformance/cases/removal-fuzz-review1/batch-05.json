					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X='' || rmdir /usr;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=sub | rmdir \"$X\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=${HOME}\nrmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=\\$HOME; rmdir sub`"
