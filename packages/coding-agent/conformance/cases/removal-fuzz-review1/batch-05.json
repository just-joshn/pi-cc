					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=.\nrmdir \"$X\""
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=$HOME\nrmdir sub; break; done"
