					},
					{
						"name": "Bash",
						"input": {
							"command": "(local X=\"*\"; rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=.. && rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X='' || rmdir $HOME; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(export X=p04-fuzz-does-not-exist || rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X='$HOME' & rmdir ~; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=..; rmdir ~`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=..; rmdir *; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X='' || rmdir $X)\nEOF"
