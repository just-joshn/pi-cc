					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=\\$HOME; rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=\"$HOME\"\nrmdir $X; done"
