{
	"id": "removal-fuzz-review1/batch-04",
	"area": "removal-fuzz-review1",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=sub & rmdir *;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=\"$HOME\"; rmdir $X/usr`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=\"$HOME\" && rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X='$HOME'; rmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X='*' && rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=$HOME | rmdir /usr;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=..; rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=${HOME} & rmdir sub/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X=${HOME}\nrmdir ..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=.. || rmdir ..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=.. | rmdir ..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=/usr || rmdir sub; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=\"*\" && rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X='*' || rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=\\$HOME\nrmdir \"*\";; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X=/; rmdir /; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=. || rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=\"$HOME\" & rmdir /usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=. && rmdir ..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X=sub\nrmdir \"$X\";; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=\\$HOME & rmdir .)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X='$HOME' & rmdir \\$X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=..\nrmdir $X/usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=.. & rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X=.. && rmdir /usr;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X='' & rmdir \"$X\";; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=~\nrmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=${HOME} & rmdir $X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=/ || rmdir \\$X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X=$HOME | rmdir .; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=$HOME\nrmdir \"*\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(local X=~ & rmdir .)"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
