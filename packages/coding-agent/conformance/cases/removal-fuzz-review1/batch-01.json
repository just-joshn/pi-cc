					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=/usr & rmdir $X/usr; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X=\\$HOME\nrmdir ..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X='$HOME' || rmdir p04-fuzz-does-not-exist)\nEOF"
