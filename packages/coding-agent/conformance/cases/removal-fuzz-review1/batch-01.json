					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=$HOME | rmdir ~; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=''\nrmdir *; fi"
