					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=. && rmdir '$X')\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X='*' && rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=$HOME && rmdir p04-fuzz-does-not-exist; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(typeset X=\"$HOME\" && rmdir \\$X)\nEOF"
