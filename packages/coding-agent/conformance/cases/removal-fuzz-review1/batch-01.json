					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X='*' & rmdir ${X}/;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=/usr & rmdir ~; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=$HOME && rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=p04-fuzz-does-not-exist\nrmdir $X/usr; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(local X=\\$HOME | rmdir '$X')"
