					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=\"*\" && rmdir ${X}/;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X=. || rmdir .; break; done"
