							"command": "true <<EOF\n$(export X=/\nrmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X=${HOME}\nrmdir ~; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do declare X=/ && rmdir ${X}/; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=/ | rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X=/usr && rmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=. & rmdir $X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X=\\$HOME; rmdir p04-fuzz-does-not-exist"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=$HOME; rmdir \"*\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=/usr\nrmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=''\nrmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=$HOME\nrmdir sub/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X=sub; rmdir $X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X=\\$HOME && rmdir sub/..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X='' || rmdir /; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=\\$HOME; rmdir sub/..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=/ & rmdir ~; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X='*' && rmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(typeset X=\"$HOME\"\nrmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X=${HOME}\nrmdir \"*\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=$HOME && rmdir \"$X\""
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=\"$HOME\"\nrmdir $X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X='*' | rmdir \"*\"`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(local X=/usr & rmdir /)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { declare X=p04-fuzz-does-not-exist | rmdir ..; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=. & rmdir $HOME; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=..\nrmdir ${X}/)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=/; rmdir /usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=${HOME} & rmdir /usr)"
