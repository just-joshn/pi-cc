{
	"id": "removal-fuzz-blind2/batch-00",
	"area": "removal-fuzz-blind2",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=sub\nrmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X=~ & rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=\\$HOME | rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=sub && rmdir \\$X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X=/usr & rmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=\"*\"\nrmdir *"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=. & rmdir ..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(local X=\"*\" || rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=\"$HOME\" & rmdir \\$X; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(local X=$HOME\nrmdir $X/usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=\\$HOME & rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X=p04-fuzz-does-not-exist || rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(export X=.; rmdir .)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X='*' | rmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=${HOME} && rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=.. | rmdir /; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X=. & rmdir /usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then local X=.. | rmdir .; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X='*' & rmdir '$X')\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=~; rmdir ~; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=sub\nrmdir \\$X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X=/ & rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=\"$HOME\" && rmdir *`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(typeset X=/usr\nrmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X=.. && rmdir .; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=sub | rmdir ${X}/; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X='*'\nrmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(local X=. && rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=\"$HOME\" & rmdir \\$X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X=~ & rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X='*' || rmdir \\$X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X='' && rmdir ${X}/)"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
