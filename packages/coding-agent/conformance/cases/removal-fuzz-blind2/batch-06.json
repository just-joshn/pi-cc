{
	"id": "removal-fuzz-blind2/batch-06",
	"area": "removal-fuzz-blind2",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "(local X=${HOME} && rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=. | rmdir *`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X=/ | rmdir '$X';; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=p04-fuzz-does-not-exist\nrmdir p04-fuzz-does-not-exist`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=\\$HOME; rmdir *; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=/ | rmdir .."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X='$HOME' && rmdir \"*\"; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=p04-fuzz-does-not-exist && rmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=\\$HOME; rmdir sub/..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=/; rmdir \"$X\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X=sub || rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X='*' || rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X='*' && rmdir sub; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=/usr || rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=.; rmdir .`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(local X=\"*\" & rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(export X=\"*\" | rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X='*'\nrmdir $X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do declare X=\"$HOME\" || rmdir $X/usr; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=\"$HOME\"; rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=. && rmdir $X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=p04-fuzz-does-not-exist & rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=~ | rmdir $X/usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=.. & rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=p04-fuzz-does-not-exist || rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "export X=. | rmdir ${X}/"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=/ | rmdir $X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X='$HOME' || rmdir .; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=.. || rmdir \"*\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=.\nrmdir \\$X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=\"*\"\nrmdir p04-fuzz-does-not-exist/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `X=~ && rmdir /`"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
