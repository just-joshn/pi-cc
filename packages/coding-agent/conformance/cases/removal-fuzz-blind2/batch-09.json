					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=$HOME || rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=.. & rmdir \\$X)\nEOF"
