					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=\"$HOME\" && rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=p04-fuzz-does-not-exist & rmdir .; break; done"
