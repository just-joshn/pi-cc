					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X='' && rmdir p04-fuzz-does-not-exist; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=''\nrmdir \"*\")\nEOF"
