					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=~ || rmdir $HOME;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X='$HOME' | rmdir ${X}/;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=\"$HOME\" || rmdir ~)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X='' | rmdir sub/..)"
