					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X='$HOME' | rmdir '$X'; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X='*' | rmdir /usr;; esac"
