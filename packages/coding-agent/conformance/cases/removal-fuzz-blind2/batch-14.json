					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X=${HOME} || rmdir \"$X\"; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=\"$HOME\"\nrmdir /usr"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X=\"*\"; rmdir p04-fuzz-does-not-exist/..)"
