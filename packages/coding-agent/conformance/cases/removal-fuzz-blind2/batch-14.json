					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=/ && rmdir .; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(X=\"$HOME\"; rmdir '$X')"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X=p04-fuzz-does-not-exist && rmdir /)"
