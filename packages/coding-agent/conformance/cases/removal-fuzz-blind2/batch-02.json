{
	"id": "removal-fuzz-blind2/batch-02",
	"area": "removal-fuzz-blind2",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=~ & rmdir \"$X\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X=~; rmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X='*'; rmdir p04-fuzz-does-not-exist; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=p04-fuzz-does-not-exist\nrmdir *"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=${HOME}\nrmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "export X=.. | rmdir p04-fuzz-does-not-exist"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X=\\$HOME || rmdir ..; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X=\\$HOME && rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=/ & rmdir \\$X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=\"$HOME\"\nrmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=$HOME && rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=''\nrmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "X=. || rmdir sub"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=p04-fuzz-does-not-exist || rmdir ~; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=/ & rmdir ~"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=.. && rmdir $X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=\\$HOME; rmdir /; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=\"*\"\nrmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=\"$HOME\" | rmdir $X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(export X=/ && rmdir ~)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=${HOME} && rmdir *; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=sub && rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X=\"*\" && rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { declare X=$HOME || rmdir sub; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X='*' & rmdir p04-fuzz-does-not-exist;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X='*' | rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { readonly X=${HOME}\nrmdir .; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `X=/ || rmdir *`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=''; rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=${HOME} | rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=sub; rmdir $X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=\\$HOME && rmdir ~; }"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
