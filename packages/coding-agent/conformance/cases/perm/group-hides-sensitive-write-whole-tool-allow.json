{
	"id": "perm/group-hides-sensitive-write-whole-tool-allow",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-opus-4-7",
		"--allowedTools",
		"Bash",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		".git/HEAD": "ref",
		"seed.txt": "S\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo $(id) > .git/config"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "{ echo T > .git/hooks_note; }"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo T > .git/config2"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 4,
				"bodyMatch": [
					"sensitive file"
				]
			}
		],
		"files": [
			".git/config",
			".git/hooks_note"
		]
	},
	"skip": []
}
