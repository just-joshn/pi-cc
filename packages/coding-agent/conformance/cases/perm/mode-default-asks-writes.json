{
	"id": "perm/mode-default-asks-writes",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-opus-4-7",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"b.txt": "a"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Write",
					"input": {
						"file_path": "a.txt",
						"content": "x"
					}
				}
			},
			{
				"tool_use": {
					"name": "Edit",
					"input": {
						"file_path": "b.txt",
						"old_string": "a",
						"new_string": "b"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"Claude requested permissions to write to [^ ]*a\\.txt, but you haven't granted it yet\\.",
				"Claude requested permissions to write to [^ ]*b\\.txt, but you haven't granted it yet\\."
			]
		},
		"files": [],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 3,
				"bodyMatch": [
					"Claude requested permissions to write to [^ ]*a\\.txt, but you haven't granted it yet\\.",
					"Claude requested permissions to write to [^ ]*b\\.txt, but you haven't granted it yet\\."
				]
			}
		]
	},
	"skip": []
}
