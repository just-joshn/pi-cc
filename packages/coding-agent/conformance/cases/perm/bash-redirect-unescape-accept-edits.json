{
	"id": "perm/bash-redirect-unescape-accept-edits",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-opus-4-7",
		"--permission-mode",
		"acceptEdits",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		".git/HEAD": "ref"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo ESC > .gi\\t/config"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo ESC > .claude/settings.j\\son"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo ESC > \".git/HEAD\""
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo OK > ok.txt"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"sensitive file",
				"requested permissions to write to"
			]
		},
		"absent": [
			"$WORKSPACE/.git/config",
			"$WORKSPACE/.claude/settings.json"
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 5,
				"bodyMatch": [
					"sensitive file",
					"requested permissions to write to"
				]
			}
		],
		"files": [
			"ok.txt"
		]
	},
	"skip": []
}
