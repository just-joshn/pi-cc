{
	"id": "perm/dangerous-rm-forms",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/inner.txt": "INNER\n",
		"sub/deep/x.txt": "X\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "rm -rf $X/"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "rm -rf $(echo /)"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "bash -c 'rm -rf .'"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "cd sub && rm -rf *"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "rm -r -f -- *"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo hi; rm -rf *"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "rm -rf \"$X\""
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 8,
				"bodyMatch": [
					"is a shell variable expansion",
					"output of a command substitution",
					"changes directories before the removal",
					"would remove a workspace directory"
				]
			}
		],
		"files": []
	},
	"skip": []
}
