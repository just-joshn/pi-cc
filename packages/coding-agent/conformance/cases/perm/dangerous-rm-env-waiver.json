{
	"id": "perm/dangerous-rm-env-waiver",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP",
		"CLAUDE_CODE_EVEN_MORE_DANGEROUSLY_SKIP_PERMISSIONS": "1"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/inner.txt": "INNER\n",
		"sub/deep/x.txt": "X\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "rm -rf ."
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "rm -rf ~"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 3,
				"bodyMatch": [
					"may not be removed"
				]
			}
		],
		"files": []
	},
	"skip": []
}
