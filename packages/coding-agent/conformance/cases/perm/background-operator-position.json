{
	"id": "perm/background-operator-position",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-opus-4-7",
		"--allowedTools",
		"Bash",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/inner.txt": "INNER\n",
		"sub/deep/x.txt": "X\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo BG_ONE & echo b"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo BG_TWO & (echo G)"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "(echo SUB_RAN &)"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "{ echo BRACE_RAN; } &"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "f(){ echo F|cat& }; echo defined"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 6,
				"bodyMatch": [
					"`&` background operator",
					"SUB_RAN",
					"BRACE_RAN",
					"defined"
				]
			}
		],
		"files": []
	},
	"skip": []
}
