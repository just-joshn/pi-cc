{
	"id": "perm/dangerous-rm-assigned-target",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/inner.txt": "INNER\n",
		"sub/deep/x.txt": "X\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "X=.; rm -rf $X"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "export X=..; rm -rf \"$X\""
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "X=.; echo hi | rm -rf $X"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "X=. && Y=$X; rm -rf $Y"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "(X=.; rm -rf $X)"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "X=.; if true; then rm -rf $X; fi"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "rm -rf \"*\""
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "rm -rf '*'"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 9,
				"bodyMatch": [
					"Dangerous rm operation detected",
					"would remove a workspace directory"
				]
			}
		],
		"files": []
	},
	"skip": []
}
