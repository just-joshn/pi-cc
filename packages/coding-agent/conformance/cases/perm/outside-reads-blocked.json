{
	"id": "perm/outside-reads-blocked",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--allowedTools",
		"Read,Bash",
		"--settings",
		"{\"permissions\":{\"blockReadsOutsideWorkingDirectories\":true}}",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/inner.txt": "INNER\n",
		"sub/deep/x.txt": "X\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "/etc/hosts"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "cat /etc/hosts"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "ls /tmp"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "cat seed.txt"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "cat $X"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo $(cat /etc/hosts)"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "grep -r foo /etc"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 8,
				"bodyMatch": [
					"setting blocks reads outside the working directories",
					"Reads outside the working directories are blocked",
					"under the read block",
					"SEED"
				]
			}
		],
		"files": []
	},
	"skip": []
}
