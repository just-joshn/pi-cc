{
	"id": "perm/mode-from-settings-and-flag-precedence",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-opus-4-7",
		"--settings",
		"{\"permissions\":{\"defaultMode\":\"dontAsk\"}}",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Write",
					"input": {
						"file_path": "a.txt",
						"content": "x"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"Permission to use Write has been denied because Claude Code is running in don't ask mode"
			]
		},
		"files": [],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2,
				"bodyMatch": [
					"Permission to use Write has been denied because Claude Code is running in don't ask mode"
				]
			}
		]
	},
	"skip": []
}
