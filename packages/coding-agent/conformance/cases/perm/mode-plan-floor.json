{
	"id": "perm/mode-plan-floor",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-haiku-4-5",
		"--permission-mode",
		"plan",
		"--allowedTools",
		"Write",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"b.txt": "a\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Write",
					"input": {
						"file_path": "a.txt",
						"content": "x"
					}
				}
			},
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "b.txt"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "ls"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"Cannot write to [^ ]*a\\.txt while in plan mode\\.",
				"b\\.txt"
			]
		},
		"files": [],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 4,
				"bodyMatch": [
					"Cannot write to [^ ]*a\\.txt while in plan mode\\.",
					"b\\.txt"
				]
			}
		]
	},
	"skip": []
}
