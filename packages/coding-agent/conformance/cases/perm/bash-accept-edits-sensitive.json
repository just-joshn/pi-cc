{
	"id": "perm/bash-accept-edits-sensitive",
	"area": "perm",
	"argv": [
		"-p",
		"Run the permission probes",
		"--model",
		"claude-opus-4-7",
		"--permission-mode",
		"acceptEdits",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		".git/HEAD": "ref",
		"b.txt": "x\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo SECRET > .git/config"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "cp b.txt .claude/settings.json"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "touch .vscode/settings.json"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "touch t.txt"
					}
				}
			},
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "echo ok > g.txt"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"sensitive"
			]
		},
		"files": [
			"t.txt",
			"g.txt"
		],
		"absent": [
			"$WORKSPACE/.git/config",
			"$WORKSPACE/.claude/settings.json",
			"$WORKSPACE/.vscode/settings.json"
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 6,
				"bodyMatch": [
					"sensitive"
				]
			}
		]
	},
	"skip": []
}
