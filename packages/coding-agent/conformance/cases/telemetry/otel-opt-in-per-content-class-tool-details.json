    "tool_use": {
     "name": "Bash",
     "input": {
      "command": "echo tool-secret-command",
      "description": "say hi"
     }
    }
   },
   {
    "text": "ZEBRA_RESPONSE_42"
   }
  ]
 },
 "timeout_ms": 60000,
 "compare": {
  "exit": 0,
  "requests": [
   {
    "pathStartsWith": "/v1/messages",
    "count": 2
   },
   {
    "pathStartsWith": "/v1/logs",
    "method": "POST",
    "count": 1,
    "bodyIncludes": [
     "\"key\":\"tool_parameters\"",
     "\"key\":\"tool_input\"",
     "tool-secret-command"
    ]
   }
  ]
 },
 "skip": [],
 "not_applicable": {
  "pi-cc": "pi-cc registers its tools under pi names until the tools PR (#7) lands, so a Bash call from the mock is an unknown tool. The same events are pinned by unit test."
 }
}