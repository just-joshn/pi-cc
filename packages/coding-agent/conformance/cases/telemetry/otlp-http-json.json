{
 "id": "telemetry/otlp-http-json",
 "area": "telemetry",
 "argv": [
  "-p",
  "Say the secret word please",
  "--output-format",
  "json"
 ],
 "env": {
  "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
  "OTEL_METRICS_EXPORTER": "otlp",
  "OTEL_LOGS_EXPORTER": "otlp",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "$MOCK_URL"
 },
 "stdin": null,
 "files": {},
 "model": {
  "turns": [
   {
    "text": "ZEBRA_RESPONSE_42"
   }
  ]
 },
 "timeout_ms": 60000,
 "compare": {
  "exit": 0,
  "requests": [
   {
    "pathStartsWith": "/v1/messages",
    "count": 1,
    "method": "POST"
   },
   {
    "pathStartsWith": "/v1/logs",
    "method": "POST",
    "count": 1,
    "headers": {
     "content-type": "application/json"
    },
    "bodyIncludes": [
     "claude_code.user_prompt",
     "claude_code.api_request",
     "claude_code.assistant_response",
     "\"key\":\"event.sequence\"",
     "\"key\":\"prompt.id\"",
     "\"key\":\"cost_usd\"",
     "\"key\":\"input_tokens\"",
     "\"key\":\"user.id\"",
     "\"key\":\"session.id\"",
     "\"key\":\"terminal.type\""
    ]
   },
   {
    "pathStartsWith": "/v1/metrics",
    "method": "POST",
    "count": 1,
    "headers": {
     "content-type": "application/json"
    },
    "bodyIncludes": [
     "claude_code.session.count",
     "claude_code.token.usage",
     "claude_code.cost.usage",
     "claude_code.active_time.total",
     "\"key\":\"type\"",
     "\"key\":\"model\"",
     "\"service.name\"",
     "\"claude-code\"",
     "\"key\":\"user.id\"",
     "\"key\":\"session.id\"",
     "\"key\":\"terminal.type\""
    ]
   }
  ]
 },
 "skip": []
}