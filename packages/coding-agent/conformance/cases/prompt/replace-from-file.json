{
	"id": "prompt/replace-from-file",
	"area": "prompt",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--system-prompt-file",
		"$WORKSPACE/sprompt.md"
	],
	"env": {},
	"stdin": null,
	"files": {
		"sprompt.md": "PROBE_FILE_PROMPT_MARKER. Answer concisely.\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"method": "POST",
				"count": 1,
				"bodyAt": {
					"system.2.text": {
						"match": [
							"^PROBE_FILE_PROMPT_MARKER\\. Answer concisely\\.\\n$"
						]
					}
				},
				"bodyLength": {
					"system.2.text": {
						"around": 44,
						"tolerance": 0.05
					}
				},
				"side": "claude",
				"deviation": "store/deviations.md, Client identity (P13, #20). Oracle retains observed client identification."
			},
			{
				"pathStartsWith": "/v1/messages",
				"method": "POST",
				"count": 1,
				"bodyAt": {
					"system.1.text": {
						"match": [
							"^PROBE_FILE_PROMPT_MARKER\\. Answer concisely\\.\\n$"
						]
					}
				},
				"bodyLength": {
					"system.1.text": {
						"around": 44,
						"tolerance": 0.05
					}
				},
				"side": "pi-cc",
				"deviation": "store/deviations.md, Client identity (P13, #20). pi-cc never identifies as an Anthropic client.",
				"bodyExcludes": [
					"x-anthropic-billing-header:",
					"You are Claude Code, Anthropic's official CLI for Claude."
				]
			}
		]
	},
	"skip": []
}
