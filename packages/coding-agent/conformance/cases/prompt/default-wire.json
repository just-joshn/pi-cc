{
	"id": "prompt/default-wire",
	"area": "prompt",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK"
	],
	"env": {},
	"stdin": null,
	"files": {},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"method": "POST",
				"count": 1,
				"headers": {
					"anthropic-beta": {
						"contains": [
							"claude-code-20250219",
							"interleaved-thinking-2025-05-14",
							"context-management-2025-06-27",
							"per-turn-control-2026-07-01",
							"mid-conversation-tool-changes-2026-07-01",
							"thinking-token-count-2026-05-13",
							"advanced-tool-use-2025-11-20",
							"effort-2025-11-24"
						],
						"excludes": [
							"mid-conversation-output-config-2026-07-01",
							"thinking-binding-controls-2026-08-01"
						]
					}
				},
				"bodyEquals": {
					"model": "claude-opus-5-5",
					"max_tokens": 128000,
					"stream": true,
					"thinking": {
						"type": "adaptive",
						"display": "omitted"
					},
					"output_config": {
						"effort": "medium"
					},
					"messages": [
						{
							"role": "user"
						},
						{
							"role": "system"
						}
					]
				},
				"bodyNotMatch": [
					"block_binding"
				],
				"bodyAt": {
