{
	"id": "prompt/autocompact-tokens-accepted",
	"area": "prompt",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--autocompact",
		"500000"
	],
	"env": {},
	"stdin": null,
	"files": {},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"equals": "PROBE_OK"
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"method": "POST",
				"count": 1
			}
		]
	},
	"skip": []
}
