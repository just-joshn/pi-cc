{
	"id": "prompt/bare-shape",
	"area": "prompt",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--bare"
	],
	"env": {},
	"stdin": null,
	"files": {},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"method": "POST",
				"count": 1,
				"bodyEquals": {
					"system": [
						{
							"type": "text"
						},
						{
							"type": "text"
						},
						{
							"type": "text"
						}
					],
					"messages": [
						{
							"role": "user"
						},
						{
							"role": "system",
							"content": [],
							"output_config": {
								"effort": "medium"
							}
						}
					]
				},
				"bodyAt": {
					"system.2.text": {
						"match": [
							"^CWD: [^\\n]+\\nDate: \\d{4}-\\d{2}-\\d{2}$"
						]
					}
				},
				"bodyLength": {
					"system.2.text": {
						"around": 156,
						"tolerance": 0.12
					}
				}
			}
		]
	},
	"skip": []
}
