{
	"id": "provider-env/custom-header-credential-reaches-the-env-endpoint",
	"area": "provider-env",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--output-format",
		"json"
	],
	"env": {
		"ANTHROPIC_CUSTOM_HEADERS": "x-api-key: header-key"
	},
	"unset": [
		"ANTHROPIC_API_KEY"
	],
	"stdin": null,
	"files": {},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"method": "POST",
				"headers": {
					"x-api-key": "header-key"
				}
			}
		]
	},
	"skip": []
}
