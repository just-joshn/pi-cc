{
	"id": "provider-env/custom-headers",
	"area": "provider-env",
	"argv": ["-p", "Reply with exactly PROBE_OK", "--output-format", "json"],
	"env": {
		"ANTHROPIC_CUSTOM_HEADERS": "x-case-one: one\nx-case-two:   two spaces  \nno-colon-line"
	},
	"stdin": null,
	"files": {},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"method": "POST",
				"headers": {
					"x-case-one": "one",
					"x-case-two": "two spaces",
					"no-colon-line": null,
					"anthropic-version": "2023-06-01"
				}
			}
		]
	},
	"skip": []
}
