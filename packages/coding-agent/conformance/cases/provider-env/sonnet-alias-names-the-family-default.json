{
	"id": "provider-env/sonnet-alias-names-the-family-default",
	"area": "provider-env",
	"argv": ["-p", "Reply with exactly PROBE_OK", "--output-format", "json"],
	"env": { "ANTHROPIC_MODEL": "sonnet" },
	"stdin": null,
	"files": {},
	"model": { "turns": [{ "text": "PROBE_OK" }] },
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"method": "POST",
				"bodyEquals": { "model": "claude-sonnet-5-5" }
			}
		]
	},
	"skip": []
}
