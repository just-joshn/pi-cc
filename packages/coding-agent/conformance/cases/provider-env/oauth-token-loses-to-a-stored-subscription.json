{
	"id": "provider-env/oauth-token-loses-to-a-stored-subscription",
	"area": "provider-env",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--output-format",
		"json"
	],
	"env": {
		"ANTHROPIC_OAUTH_TOKEN": "sk-ant-oat01-ENVOAUTH"
	},
	"unset": [
		"ANTHROPIC_API_KEY"
	],
	"stdin": null,
	"files": {
		"$AGENT/auth.json": "{\"anthropic\": {\"type\": \"oauth\", \"access\": \"sk-ant-oat01-STORED-SUB\", \"refresh\": \"sk-ant-ort01-r\", \"expires\": 4102444800000}}",
		"$CONFIG/.credentials.json": "{\"claudeAiOauth\": {\"accessToken\": \"sk-ant-oat01-STORED-SUB\", \"refreshToken\": \"sk-ant-ort01-r\", \"expiresAt\": 4102444800000, \"scopes\": [\"user:inference\"], \"subscriptionType\": \"max\"}}"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"method": "POST",
				"headers": {
					"authorization": "Bearer sk-ant-oat01-STORED-SUB",
					"x-api-key": null
				}
			}
		]
	},
	"skip": []
}
