{
	"id": "provider-env/settings-model-lookalike-is-sent-verbatim",
	"area": "provider-env",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--output-format",
		"json"
	],
	"env": {},
	"stdin": null,
	"files": {
		"$CONFIG/settings.json": "{\"model\": \"glm-4.6\"}"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"method": "POST",
				"bodyEquals": {
					"model": "glm-4.6"
				}
			}
		]
	},
	"skip": []
}
