{
	"id": "cli/session-id-invalid-with-version",
	"area": "cli",
	"argv": [
		"--session-id",
		"not-a-uuid",
		"--version"
	],
	"env": {},
	"stdin": null,
	"files": {},
	"model": null,
	"timeout_ms": 30000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"equals": "<version>",
			"normalize": [
				"version"
			],
			"match": [
				"^\\S+ \\([^)]+\\)$"
			]
		},
		"stderr": {
			"equals": ""
		},
		"requests": []
	},
	"skip": []
}
