{
	"id": "grepglob/grep-long-line-omission",
	"area": "grepglob",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--output-format",
		"stream-json",
		"--verbose",
		"--allowedTools",
		"Grep,Glob,Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"long.txt": "\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "MATCH",
						"output_mode": "content",
						"path": "long.txt"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 180000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 1,
				"bodyAt": {
					"messages": {
						"match": [
							"\\{(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"type\":\"tool_result\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"tool_use_id\":\"toolu_conformance_0_0\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"content\":(?:\"1:\\[Omitted long matching line\\]\"|\\[(?:\\{\"type\":\"text\",\"text\":\"1:\\[Omitted long matching line\\]\"\\}|\\{\"text\":\"1:\\[Omitted long matching line\\]\",\"type\":\"text\"\\})\\]))(?!(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"is_error\":true)"
						]
					}
				}
			}
		]
	},
	"skip": []
}
