{
	"id": "grepglob/glob-ties-membership-grep-ties-alpha",
	"area": "grepglob",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--output-format",
		"stream-json",
		"--verbose",
		"--allowedTools",
		"Grep,Glob,Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"tie/t1.txt": "tie\n",
		"tie/t2.txt": "tie\n",
		"tie/t3.txt": "tie\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "touch -t 202501010000 tie/t1.txt tie/t2.txt tie/t3.txt && printf SEARCH_FIXTURE_PREPARED",
						"description": "Prepare isolated search fixtures"
					}
				}
			},
			{
				"tool_use": {
					"name": "Glob",
					"input": {
						"pattern": "tie/*.txt"
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "tie",
						"path": "tie"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 180000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 4
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 1,
				"bodyAt": {
					"messages": {
