						]
					}
				}
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 2,
				"bodyAt": {
					"messages": {
						"match": [
							"\\{(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"type\":\"tool_result\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"tool_use_id\":\"toolu_conformance_1_0\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"content\":(?:\"(?=[^\"]*tie/t1\\.txt)(?=[^\"]*tie/t2\\.txt)(?=[^\"]*tie/t3\\.txt)(?:tie/t1\\.txt|tie/t2\\.txt|tie/t3\\.txt)(?:\\\\n(?:tie/t1\\.txt|tie/t2\\.txt|tie/t3\\.txt)){2}\"|\\[(?:\\{\"type\":\"text\",\"text\":\"(?=[^\"]*tie/t1\\.txt)(?=[^\"]*tie/t2\\.txt)(?=[^\"]*tie/t3\\.txt)(?:tie/t1\\.txt|tie/t2\\.txt|tie/t3\\.txt)(?:\\\\n(?:tie/t1\\.txt|tie/t2\\.txt|tie/t3\\.txt)){2}\"\\}|\\{\"text\":\"(?=[^\"]*tie/t1\\.txt)(?=[^\"]*tie/t2\\.txt)(?=[^\"]*tie/t3\\.txt)(?:tie/t1\\.txt|tie/t2\\.txt|tie/t3\\.txt)(?:\\\\n(?:tie/t1\\.txt|tie/t2\\.txt|tie/t3\\.txt)){2}\",\"type\":\"text\"\\})\\]))(?!(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"is_error\":true)"
						]
					}
				}
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 3,
				"bodyAt": {
					"messages": {
						"match": [
							"\\{(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"type\":\"tool_result\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"tool_use_id\":\"toolu_conformance_2_0\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"content\":(?:\"Found 3 files\\\\ntie/t1\\.txt\\\\ntie/t2\\.txt\\\\ntie/t3\\.txt\"|\\[(?:\\{\"type\":\"text\",\"text\":\"Found 3 files\\\\ntie/t1\\.txt\\\\ntie/t2\\.txt\\\\ntie/t3\\.txt\"\\}|\\{\"text\":\"Found 3 files\\\\ntie/t1\\.txt\\\\ntie/t2\\.txt\\\\ntie/t3\\.txt\",\"type\":\"text\"\\})\\]))(?!(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"is_error\":true)"
