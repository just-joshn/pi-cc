				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "MATCH",
						"path": "ctx.txt",
						"output_mode": "content",
						"-A": 1
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "MATCH",
						"path": "ctx.txt",
						"output_mode": "content",
						"context": 1
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "MATCH",
						"path": "ctx.txt",
						"output_mode": "content",
						"-C": 1,
						"-A": 3
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "MATCH",
						"path": "ctx.txt",
						"-C": 2
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "MATCH",
						"path": "ctx.txt",
						"output_mode": "content",
						"-o": true
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 180000,
