				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "MATCH",
						"path": "ctx.txt",
						"output_mode": "content",
						"-C": 2
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "MATCH",
						"path": "ctx.txt",
						"output_mode": "content",
						"-B": 1
