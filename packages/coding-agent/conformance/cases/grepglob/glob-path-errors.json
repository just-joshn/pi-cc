{
	"id": "grepglob/glob-path-errors",
	"area": "grepglob",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--output-format",
		"stream-json",
		"--verbose",
		"--allowedTools",
		"Grep,Glob,Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"src/a.ts": "export const alpha = 1;\nconst Needle = 2;\n",
		"src/b.ts": "export const alpha = 2;\n// needle here\n",
		"src/sub/c.ts": "alpha in c\n",
		"src/sub/deep/d.ts": "alpha in d\n",
		"docs/readme.md": "# Readme\nalpha docs\nneedle docs\n",
		".hidden/h.txt": "alpha hidden\n",
		".secret.ts": "alpha secret\n",
		"ignored/x.ts": "alpha ignored\n",
		"app.log": "alpha log\n",
		"node_modules/m.js": "alpha module\n",
		".gitignore": "ignored/\n*.log\n",
		".git/HEAD": "ref: refs/heads/main\n",
		".git/config": "alpha gitconfig\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Glob",
					"input": {
						"pattern": "*",
						"path": "nonexistent"
					}
				}
			},
			{
				"tool_use": {
					"name": "Glob",
					"input": {
						"pattern": "*",
						"path": "src/a.ts"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 180000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 3
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 1,
				"bodyAt": {
					"messages": {
						"match": [
							"\\{(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"type\":\"tool_result\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"tool_use_id\":\"toolu_conformance_0_0\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"content\":(?:\"Directory does not exist: nonexistent\\. Note: your current working directory is [^\"]+\\.\"|\\[(?:\\{\"type\":\"text\",\"text\":\"Directory does not exist: nonexistent\\. Note: your current working directory is [^\"]+\\.\"\\}|\\{\"text\":\"Directory does not exist: nonexistent\\. Note: your current working directory is [^\"]+\\.\",\"type\":\"text\"\\})\\]))(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"is_error\":true)"
						]
					}
				}
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 2,
				"bodyAt": {
					"messages": {
						"match": [
							"\\{(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"type\":\"tool_result\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"tool_use_id\":\"toolu_conformance_1_0\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"content\":(?:\"Path is not a directory: src/a\\.ts\"|\\[(?:\\{\"type\":\"text\",\"text\":\"Path is not a directory: src/a\\.ts\"\\}|\\{\"text\":\"Path is not a directory: src/a\\.ts\",\"type\":\"text\"\\})\\]))(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"is_error\":true)"
						]
					}
				}
			}
		]
	},
	"skip": []
}
