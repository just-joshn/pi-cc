{
	"id": "grepglob/grep-ignore-without-git",
	"area": "grepglob",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--output-format",
		"stream-json",
		"--verbose",
		"--allowedTools",
		"Grep,Glob,Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		".gitignore": "ignored/\n*.log\n",
		"ignored/x.ts": "alpha ignored\n",
		"app.log": "alpha log\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "alpha"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 180000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 1,
				"bodyAt": {
					"messages": {
						"match": [
							"\\{(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"type\":\"tool_result\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"tool_use_id\":\"toolu_conformance_0_0\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"content\":(?:\"(?=[^\"]*ignored/x\\.ts)(?=[^\"]*app\\.log)Found 2 files\\\\n(?:ignored/x\\.ts|app\\.log)(?:\\\\n(?:ignored/x\\.ts|app\\.log)){1}\"|\\[(?:\\{\"type\":\"text\",\"text\":\"(?=[^\"]*ignored/x\\.ts)(?=[^\"]*app\\.log)Found 2 files\\\\n(?:ignored/x\\.ts|app\\.log)(?:\\\\n(?:ignored/x\\.ts|app\\.log)){1}\"\\}|\\{\"text\":\"(?=[^\"]*ignored/x\\.ts)(?=[^\"]*app\\.log)Found 2 files\\\\n(?:ignored/x\\.ts|app\\.log)(?:\\\\n(?:ignored/x\\.ts|app\\.log)){1}\",\"type\":\"text\"\\})\\]))(?!(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"is_error\":true)"
						]
					}
				}
			}
		]
	},
	"skip": []
}
