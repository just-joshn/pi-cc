{
	"id": "grepglob/t09-tools-read-edit",
	"area": "grepglob",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--output-format",
		"stream-json",
		"--verbose",
		"--tools",
		"Read,Edit"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 180000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK",
				"^\\{(?=[^\\n]*\"subtype\":\"init\")[^\\n]*\"tools\":\\[(?![^\\]]*\"Grep\")[^\\]]*\\]",
				"^\\{(?=[^\\n]*\"subtype\":\"init\")[^\\n]*\"tools\":\\[(?![^\\]]*\"Glob\")[^\\]]*\\]",
				"^\\{(?=[^\\n]*\"subtype\":\"init\")[^\\n]*\"tools\":\\[(?![^\\]]*\"Bash\")[^\\]]*\\]"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1,
				"index": 0,
				"bodyAt": {
					"tools": {
						"match": [],
						"notMatch": [
							"\"name\":\"Grep\"",
							"\"name\":\"Glob\"",
							"\"name\":\"Bash\""
						]
					}
				},
				"bodyEquals": {
					"tools": [
						{
							"name": "Edit"
						},
						{
							"name": "DeferredToolPlaceholder"
						},
						{
							"name": "Read"
						}
					]
				}
			}
		]
	},
	"skip": []
}
