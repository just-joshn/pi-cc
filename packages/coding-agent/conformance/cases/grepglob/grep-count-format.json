{
	"id": "grepglob/grep-count-format",
	"area": "grepglob",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--output-format",
		"stream-json",
		"--verbose",
		"--allowedTools",
		"Grep,Glob,Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"src/a.ts": "export const alpha = 1;\nconst Needle = 2;\n",
		"src/b.ts": "export const alpha = 2;\n// needle here\n",
		"src/sub/c.ts": "alpha in c\n",
		"src/sub/deep/d.ts": "alpha in d\n",
		"docs/readme.md": "# Readme\nalpha docs\nneedle docs\n",
		".hidden/h.txt": "alpha hidden\n",
		".secret.ts": "alpha secret\n",
		"ignored/x.ts": "alpha ignored\n",
		"app.log": "alpha log\n",
		"node_modules/m.js": "alpha module\n",
		".gitignore": "ignored/\n*.log\n",
		".git/HEAD": "ref: refs/heads/main\n",
		".git/config": "alpha gitconfig\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "alpha",
						"output_mode": "count",
						"path": "src/a.ts"
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "alpha|Needle",
						"output_mode": "count",
						"path": "src/a.ts"
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "alpha",
						"output_mode": "count",
						"path": "src"
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "zzznomatch",
						"output_mode": "count"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 180000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"PROBE_OK"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 5
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 1,
				"bodyAt": {
					"messages": {
						"match": [
							"\\{(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"type\":\"tool_result\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"tool_use_id\":\"toolu_conformance_0_0\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"content\":(?:\"src/a\\.ts:1\\\\n\\\\nFound 1 total occurrence across 1 file\\.\"|\\[(?:\\{\"type\":\"text\",\"text\":\"src/a\\.ts:1\\\\n\\\\nFound 1 total occurrence across 1 file\\.\"\\}|\\{\"text\":\"src/a\\.ts:1\\\\n\\\\nFound 1 total occurrence across 1 file\\.\",\"type\":\"text\"\\})\\]))(?!(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"is_error\":true)"
						]
					}
				}
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 2,
				"bodyAt": {
					"messages": {
						"match": [
							"\\{(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"type\":\"tool_result\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"tool_use_id\":\"toolu_conformance_1_0\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"content\":(?:\"src/a\\.ts:2\\\\n\\\\nFound 2 total occurrences across 1 file\\.\"|\\[(?:\\{\"type\":\"text\",\"text\":\"src/a\\.ts:2\\\\n\\\\nFound 2 total occurrences across 1 file\\.\"\\}|\\{\"text\":\"src/a\\.ts:2\\\\n\\\\nFound 2 total occurrences across 1 file\\.\",\"type\":\"text\"\\})\\]))(?!(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"is_error\":true)"
						]
					}
				}
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 3,
				"bodyAt": {
					"messages": {
						"match": [
							"\\{(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"type\":\"tool_result\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"tool_use_id\":\"toolu_conformance_2_0\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"content\":(?:\"(?=[^\"]*src/a\\.ts:1)(?=[^\"]*src/sub/c\\.ts:1)(?=[^\"]*src/sub/deep/d\\.ts:1)(?=[^\"]*src/b\\.ts:1)(?:src/a\\.ts:1|src/sub/c\\.ts:1|src/sub/deep/d\\.ts:1|src/b\\.ts:1)(?:\\\\n(?:src/a\\.ts:1|src/sub/c\\.ts:1|src/sub/deep/d\\.ts:1|src/b\\.ts:1)){3}\\\\n\\\\nFound 4 total occurrences across 4 files\\.\"|\\[(?:\\{\"type\":\"text\",\"text\":\"(?=[^\"]*src/a\\.ts:1)(?=[^\"]*src/sub/c\\.ts:1)(?=[^\"]*src/sub/deep/d\\.ts:1)(?=[^\"]*src/b\\.ts:1)(?:src/a\\.ts:1|src/sub/c\\.ts:1|src/sub/deep/d\\.ts:1|src/b\\.ts:1)(?:\\\\n(?:src/a\\.ts:1|src/sub/c\\.ts:1|src/sub/deep/d\\.ts:1|src/b\\.ts:1)){3}\\\\n\\\\nFound 4 total occurrences across 4 files\\.\"\\}|\\{\"text\":\"(?=[^\"]*src/a\\.ts:1)(?=[^\"]*src/sub/c\\.ts:1)(?=[^\"]*src/sub/deep/d\\.ts:1)(?=[^\"]*src/b\\.ts:1)(?:src/a\\.ts:1|src/sub/c\\.ts:1|src/sub/deep/d\\.ts:1|src/b\\.ts:1)(?:\\\\n(?:src/a\\.ts:1|src/sub/c\\.ts:1|src/sub/deep/d\\.ts:1|src/b\\.ts:1)){3}\\\\n\\\\nFound 4 total occurrences across 4 files\\.\",\"type\":\"text\"\\})\\]))(?!(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"is_error\":true)"
						]
					}
				}
			},
			{
				"pathStartsWith": "/v1/messages",
				"index": 4,
				"bodyAt": {
					"messages": {
						"match": [
							"\\{(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"type\":\"tool_result\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"tool_use_id\":\"toolu_conformance_3_0\")(?=(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"content\":(?:\"No matches found\\\\n\\\\nFound 0 total occurrences across 0 files\\.\"|\\[(?:\\{\"type\":\"text\",\"text\":\"No matches found\\\\n\\\\nFound 0 total occurrences across 0 files\\.\"\\}|\\{\"text\":\"No matches found\\\\n\\\\nFound 0 total occurrences across 0 files\\.\",\"type\":\"text\"\\})\\]))(?!(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^\"{}]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\"is_error\":true)"
						]
					}
				}
			}
		]
	},
	"skip": []
}
