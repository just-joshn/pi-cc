				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "alpha",
						"type": "md"
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "alpha",
						"type": "ts",
						"glob": "*.ts"
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "alpha",
						"glob": "*.md"
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "alpha",
						"glob": "*.{md,txt}"
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "alpha",
						"glob": "!*.ts"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
