		"turns": [
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "NEEDLE",
						"path": "src"
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
						"pattern": "NEEDLE",
						"path": "src",
						"-i": true
					}
				}
			},
			{
				"tool_use": {
					"name": "Grep",
					"input": {
