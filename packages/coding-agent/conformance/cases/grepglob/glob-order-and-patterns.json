{
	"id": "grepglob/glob-order-and-patterns",
	"area": "grepglob",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--output-format",
		"stream-json",
		"--verbose",
		"--allowedTools",
		"Grep,Glob,Bash"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"src/a.ts": "export const alpha = 1;\nconst Needle = 2;\n",
		"src/b.ts": "export const alpha = 2;\n// needle here\n",
		"src/sub/c.ts": "alpha in c\n",
		"src/sub/deep/d.ts": "alpha in d\n",
		"docs/readme.md": "# Readme\nalpha docs\nneedle docs\n",
		".hidden/h.txt": "alpha hidden\n",
		".secret.ts": "alpha secret\n",
		"ignored/x.ts": "alpha ignored\n",
		"app.log": "alpha log\n",
		"node_modules/m.js": "alpha module\n",
		".gitignore": "ignored/\n*.log\n",
		".git/HEAD": "ref: refs/heads/main\n",
		".git/config": "alpha gitconfig\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Bash",
					"input": {
						"command": "touch -t 202001010000 'src/a.ts' && touch -t 202101010000 'src/sub/c.ts' && touch -t 202201010000 'src/sub/deep/d.ts' && touch -t 202301010000 'src/b.ts' && touch -t 202401010000 'docs/readme.md' && touch -t 202501010000 '.hidden/h.txt' && touch -t 202601010000 '.secret.ts' && touch -t 202701010000 'node_modules/m.js' && printf SEARCH_FIXTURE_PREPARED",
						"description": "Prepare isolated search fixtures"
					}
				}
			},
			{
				"tool_use": {
					"name": "Glob",
					"input": {
						"pattern": "src/**/*.ts"
					}
				}
			},
			{
				"tool_use": {
					"name": "Glob",
					"input": {
						"pattern": "*.ts",
						"path": "src"
					}
				}
			},
			{
				"tool_use": {
					"name": "Glob",
					"input": {
						"pattern": "**/*.ts"
					}
				}
			},
			{
				"tool_use": {
					"name": "Glob",
					"input": {
						"pattern": "**/*.{ts,md}"
					}
				}
			},
			{
				"tool_use": {
					"name": "Glob",
					"input": {
						"pattern": "*.TS"
					}
				}
			},
			{
				"tool_use": {
					"name": "Glob",
					"input": {
						"pattern": "**/*.nomatch"
					}
				}
			},
			{
				"tool_use": {
					"name": "Glob",
					"input": {
						"pattern": "docs/../src/*.ts"
					}
				}
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 180000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
