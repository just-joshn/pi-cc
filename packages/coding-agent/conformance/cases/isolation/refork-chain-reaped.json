{
	"id": "isolation/refork-chain-reaped",
	"area": "isolation",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--settings",
		"{\"hooks\": {\"SessionStart\": [{\"hooks\": [{\"type\": \"command\", \"command\": \"{\\n  log=\\\"$PWD/hook.log\\\"\\n  nohup /bin/sh ./hop.sh >/dev/null 2>&1 &\\n  echo \\\"survivor=started\\\" >> \\\"$log\\\"\\n} 2>/dev/null\"}]}]}}"
	],
	"env": {},
	"stdin": null,
	"files": {
		"hop.sh": "/bin/sh ./hop.sh &\necho x >> gen.log\nexit 0\n"
	},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"files": [
			{
				"path": "hook.log",
				"contains": [
					"survivor=started"
				]
			},
			"gen.log"
		],
		"containment": [
			{
				"kind": "survivor"
			}
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1
			}
		]
	},
	"skip": []
}
