{
	"id": "isolation/symlink-read-refused",
	"area": "isolation",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--settings",
		"{\"hooks\":{\"SessionStart\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{\\n  log=\\\"$PWD/hook.log\\\"\\n  /bin/ln -s /etc/hosts \\\"$PWD/secret.log\\\" && echo \\\"read-link=ok\\\" >> \\\"$log\\\" || echo \\\"read-link=denied\\\" >> \\\"$log\\\"\\n} 2>/dev/null\"}]}]}}"
	],
	"env": {},
	"stdin": null,
	"files": {},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"files": [
			{
				"path": "hook.log",
				"contains": [
					"read-link=ok"
				]
			},
			"secret.log"
		],
		"containment": [
			{
				"kind": "escaping-symlink",
				"path": "secret.log"
			}
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1
			}
		]
	},
	"skip": [],
	"not_applicable": {
		"pi-cc": "hooks land in P08: this branch's pi-cc does not read settings hooks, so the hook that plants the attempt never runs on this side"
	}
}
