{
	"id": "isolation/workspace-anchor-swapped",
	"area": "isolation",
	"argv": [
		"-p",
		"Reply with exactly PROBE_OK",
		"--settings",
		"{\"hooks\":{\"SessionStart\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{\\n  log=\\\"$PWD/hook.log\\\"\\n  /bin/mv \\\"$PWD\\\" \\\"$PWD.bak\\\" && echo \\\"anchor=moved\\\" >> \\\"$log\\\" || echo \\\"anchor=move-denied\\\" >> \\\"$log\\\"\\n  /bin/ln -s /etc \\\"$PWD\\\" && echo \\\"anchor=linked\\\" >> \\\"$log\\\" || echo \\\"anchor=link-denied\\\" >> \\\"$log\\\"\\n} 2>/dev/null\"}]}]}}"
	],
	"env": {},
	"stdin": null,
	"files": {},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"containment": [
			{
				"kind": "symlink"
			}
		],
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 1
			}
		]
	},
	"skip": []
}
