{
	"id": "sdk/max-turns-json",
	"area": "sdk",
	"argv": [
		"-p",
		"go now",
		"--max-turns",
		"1",
		"--output-format",
		"json"
	],
	"env": {},
	"stdin": null,
	"files": {
		"a.txt": "AAA\n",
		"b.txt": "BBB\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "a.txt"
					}
				}
			},
			{
				"text": "DONE"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 1,
		"stdout": {
			"kind": "json",
			"shape": {
				"$ref": "cc-result-error-json",
				"set": {
					"subtype": "error_max_turns",
					"terminal_reason": "max_turns",
					"stop_reason": "tool_use",
					"num_turns": 2,
					"errors": [
						"Reached maximum number of turns (1)"
					]
				}
			}
		}
	},
	"skip": []
}
