{
	"id": "sdk/unknown-control-subtype-errors",
	"area": "sdk",
	"argv": [
		"-p",
		"--input-format",
		"stream-json",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {},
	"stdin": {
		"kind": "stream-json",
		"lines": [
			"{\"type\": \"control_request\", \"request_id\": \"r1\", \"request\": {\"subtype\": \"bogus_subtype\"}}",
			"{\"type\": \"user\", \"message\": {\"role\": \"user\", \"content\": \"hello\"}}"
		]
	},
	"files": {},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "frames",
			"frames": [
				{
					"type": "control_response",
					"response": {
						"subtype": "error",
						"request_id": "r1",
						"error": "Unsupported control request subtype: bogus_subtype"
					}
				},
				{
					"$ref": "cc-init"
				},
				{
					"$ref": "cc-assistant-text",
					"set": {
						"message.content": [
							{
								"type": "text",
								"text": "PROBE_OK"
							}
						]
					}
				},
				{
					"$ref": "cc-result",
					"set": {
						"is_error": false,
						"num_turns": 1,
						"subtype": "success",
						"result": "PROBE_OK",
						"terminal_reason": "completed",
						"permission_denials": [],
						"stop_reason": "end_turn"
					}
				}
			]
		}
	},
	"skip": []
}
