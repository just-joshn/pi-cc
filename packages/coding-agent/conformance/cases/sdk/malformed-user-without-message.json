{
	"id": "sdk/malformed-user-without-message",
	"area": "sdk",
	"argv": [
		"-p",
		"--input-format",
		"stream-json",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {},
	"stdin": {
		"kind": "stream-json",
		"lines": [
			"{\"type\": \"user\"}",
			"{\"type\": \"user\", \"message\": {\"role\": \"user\", \"content\": \"hello\"}}"
		]
	},
	"files": {},
	"model": {
		"turns": [
			{
				"text": "A"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 1,
		"stdout": {
			"kind": "text",
			"equals": ""
		},
		"stderr": {
			"contains": [
				"Error: Expected message role 'user', got 'undefined'"
			]
		}
	},
	"skip": []
}
