{
	"id": "sdk/assistant-split-per-content-block",
	"area": "sdk",
	"argv": [
		"-p",
		"Read the fixture file",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {},
	"stdin": null,
	"files": {
		"tool_fixture.txt": "LINE_A\nLINE_B\n"
	},
	"model": {
		"turns": [
			{
				"sse": [
					{
						"type": "message_start",
						"message": {
							"id": "msg_m",
							"type": "message",
							"role": "assistant",
							"model": "claude-haiku-4-5",
							"content": [],
							"stop_reason": null,
							"stop_sequence": null,
							"usage": {
								"input_tokens": 12,
								"output_tokens": 0
							}
						}
					},
					{
						"type": "content_block_start",
						"index": 0,
						"content_block": {
							"type": "text",
							"text": ""
						}
					},
					{
						"type": "content_block_delta",
						"index": 0,
						"delta": {
							"type": "text_delta",
							"text": "Reading now"
						}
					},
					{
						"type": "content_block_stop",
						"index": 0
					},
					{
						"type": "content_block_start",
						"index": 1,
						"content_block": {
							"type": "tool_use",
							"id": "toolu_m1",
							"name": "Read",
							"input": {}
						}
					},
					{
						"type": "content_block_delta",
						"index": 1,
						"delta": {
							"type": "input_json_delta",
							"partial_json": "{\"file_path\":\"tool_fixture.txt\"}"
						}
					},
					{
						"type": "content_block_stop",
						"index": 1
					},
					{
						"type": "message_delta",
						"delta": {
							"stop_reason": "tool_use",
							"stop_sequence": null
						},
						"usage": {
							"output_tokens": 8
						}
					},
					{
						"type": "message_stop"
					}
				]
			},
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "frames",
			"frames": [
				{
					"$ref": "cc-init"
				},
				{
					"$ref": "cc-assistant-text",
					"set": {
						"message.content": [
							{
								"type": "text",
								"text": "Reading now"
							}
						],
						"message.id": "msg_m"
					}
				},
				{
					"$ref": "cc-assistant-tool-use",
					"set": {
						"message.content": [
							{
								"type": "tool_use",
								"id": "toolu_m1",
								"name": "Read",
								"input": {
									"file_path": "tool_fixture.txt"
								}
							}
						],
						"message.id": "msg_m"
					}
				},
				{
					"$ref": "cc-user-tool-result",
					"set": {
						"message.content": [
							{
								"tool_use_id": "toolu_m1",
								"type": "tool_result",
								"content": "1\tLINE_A\n2\tLINE_B\n3\t"
							}
						]
					}
				},
				{
					"$ref": "cc-assistant-text",
					"set": {
						"message.content": [
							{
								"type": "text",
								"text": "PROBE_OK"
							}
						]
					}
				},
				{
					"$ref": "cc-result",
					"set": {
						"num_turns": 2
					}
				}
			]
		}
	},
	"skip": []
}
