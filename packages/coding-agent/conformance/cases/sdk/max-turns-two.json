{
	"id": "sdk/max-turns-two",
	"area": "sdk",
	"argv": [
		"-p",
		"go now",
		"--max-turns",
		"2",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {},
	"stdin": null,
	"files": {
		"a.txt": "AAA\n",
		"b.txt": "BBB\n"
	},
	"model": {
		"turns": [
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "a.txt"
					}
				}
			},
			{
				"tool_use": {
					"name": "Read",
					"input": {
						"file_path": "b.txt"
					}
				}
			},
			{
				"text": "DONE"
			}
		]
	},
	"timeout_ms": 90000,
	"compare": {
		"exit": 1,
		"stdout": {
			"kind": "frames",
			"frames": [
				{
					"$ref": "cc-init"
				},
				{
					"$ref": "cc-assistant-tool-use",
					"set": {
						"message.content": [
							{
								"type": "tool_use",
								"id": "toolu_conformance_0_0",
								"name": "Read",
								"input": {
									"file_path": "a.txt"
								}
							}
						]
					}
				},
				{
					"$ref": "cc-user-tool-result",
					"set": {
						"message.content": [
							{
								"tool_use_id": "toolu_conformance_0_0",
								"type": "tool_result",
								"content": "1\tAAA\n2\t"
							}
						]
					}
				},
				{
					"$ref": "cc-assistant-tool-use",
					"set": {
						"message.content": [
							{
								"type": "tool_use",
								"id": "toolu_conformance_1_0",
								"name": "Read",
								"input": {
									"file_path": "b.txt"
								}
							}
						]
					}
				},
				{
					"$ref": "cc-user-tool-result",
					"set": {
						"message.content": [
							{
								"tool_use_id": "toolu_conformance_1_0",
								"type": "tool_result",
								"content": "1\tBBB\n2\t"
							}
						]
					}
				},
				{
					"$ref": "cc-result-error",
					"set": {
						"subtype": "error_max_turns",
						"terminal_reason": "max_turns",
						"stop_reason": "tool_use",
						"num_turns": 3,
						"errors": [
							"Reached maximum number of turns (2)"
						],
						"usage.input_tokens": 24,
						"usage.output_tokens": 16
					}
				}
			]
		}
	},
	"skip": []
}
