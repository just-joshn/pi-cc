{
	"id": "sdk/input-user-content-blocks",
	"area": "sdk",
	"argv": [
		"-p",
		"--input-format",
		"stream-json",
		"--output-format",
		"stream-json",
		"--verbose",
		"--replay-user-messages"
	],
	"env": {},
	"stdin": {
		"kind": "stream-json",
		"lines": [
			"{\"type\": \"user\", \"message\": {\"role\": \"user\", \"content\": [{\"type\": \"text\", \"text\": \"blocky\"}]}}"
		]
	},
	"files": {},
	"model": {
		"turns": [
			{
				"text": "A"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "frames",
			"frames": [
				{
					"$ref": "cc-init"
				},
				{
					"$ref": "cc-user-replay",
					"set": {
						"message.content": [
							{
								"type": "text",
								"text": "blocky"
							}
						]
					}
				},
				{
					"$ref": "cc-assistant-text",
					"set": {
						"message.content": [
							{
								"type": "text",
								"text": "A"
							}
						]
					}
				},
				{
					"$ref": "cc-result",
					"set": {
						"result": "A"
					}
				}
			]
		}
	},
	"skip": []
}
