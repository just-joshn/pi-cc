{
	"id": "sdk/json-verbose-array",
	"area": "sdk",
	"argv": [
		"-p",
		"hello",
		"--output-format",
		"json",
		"--verbose"
	],
	"env": {},
	"stdin": null,
	"files": {},
	"model": {
		"turns": [
			{
				"text": "PROBE_OK"
			}
		]
	},
	"timeout_ms": 60000,
	"compare": {
