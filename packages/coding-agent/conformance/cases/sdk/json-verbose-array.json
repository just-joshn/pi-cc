						"message.content": [
							{
								"type": "text",
								"text": "PROBE_OK"
							}
						]
					}
				},
				{
					"$ref": "cc-result-json",
					"set": {
						"is_error": false,
						"num_turns": 1,
						"subtype": "success",
						"result": "PROBE_OK",
						"terminal_reason": "completed",
						"permission_denials": [],
						"stop_reason": "end_turn"
					}
				}
			]
		}
	},
	"skip": []
}
