					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(export X=p04-fuzz-does-not-exist; rmdir \"*\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X=..\nrmdir $X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X=$HOME\nrmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X='$HOME' | rmdir *;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X='*'; rmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X='$HOME'; rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=.. || rmdir ..; }"
