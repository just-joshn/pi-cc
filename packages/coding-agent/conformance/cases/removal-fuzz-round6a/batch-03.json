					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X='$HOME' && rmdir $X/usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=.. || rmdir $HOME; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=/usr; rmdir p04-fuzz-does-not-exist)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=\"$HOME\" & rmdir *; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=${HOME} & rmdir \"*\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X='' || rmdir p04-fuzz-does-not-exist/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=$HOME & rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=.\nrmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=$HOME & rmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X='*' | rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=$HOME || rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X='*' || rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X=$HOME || rmdir p04-fuzz-does-not-exist;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `X=\"*\"; rmdir ~`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X=. && rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(X=..; rmdir '$X')\nEOF"
