					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(export X=\\$HOME\nrmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=${HOME}; rmdir ${X}/; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=sub || rmdir $HOME; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X='$HOME' & rmdir sub)\nEOF"
