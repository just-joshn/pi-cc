{
	"id": "removal-fuzz-round6a/batch-03",
	"area": "removal-fuzz-round6a",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
