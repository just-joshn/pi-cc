{
	"id": "removal-fuzz/batch-10",
	"area": "removal-fuzz",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=/; rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=\"$HOME\" | rmdir ~; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=\"*\"\nrmdir sub/..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=~ || rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=\\$HOME & rmdir \"$X\"`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=~ | rmdir ~)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `local X=/usr & rmdir '$X'`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=/usr; rmdir \\$X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=p04-fuzz-does-not-exist & rmdir '$X'; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X='' || rmdir \\$X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(typeset X=. || rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=\\$HOME && rmdir p04-fuzz-does-not-exist/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X=${HOME}; rmdir *;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=..; rmdir \"$X\"; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=\"*\" | rmdir /usr;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X=sub; rmdir ..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X=..\nrmdir '$X'; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=\"*\"; rmdir $HOME; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=$HOME | rmdir \"*\"; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then local X=~ & rmdir /usr; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(local X=\\$HOME && rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(typeset X='' | rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=/usr\nrmdir '$X'"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X=sub; rmdir .;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X='' && rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X=\\$HOME || rmdir '$X'; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X='' | rmdir ${X}/; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X=. && rmdir ~; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `typeset X=~ & rmdir sub`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=\"$HOME\" | rmdir \\$X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X=\\$HOME | rmdir $X/usr"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=p04-fuzz-does-not-exist || rmdir \"*\"; fi"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
