{
	"id": "removal-fuzz/batch-04",
	"area": "removal-fuzz",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "f() { X='' & rmdir '$X'; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=\"*\"; rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=\"$HOME\"; rmdir $HOME; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=${HOME} | rmdir '$X';; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=. & rmdir sub/..; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=. & rmdir p04-fuzz-does-not-exist; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=sub && rmdir \"*\"; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(typeset X=sub & rmdir .)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=.. & rmdir \\$X; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X='*' || rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=$HOME & rmdir .; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(local X=sub | rmdir $HOME)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X=${HOME}; rmdir $X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=.; rmdir \"$X\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X='$HOME' & rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X=${HOME}\nrmdir ..; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=\"$HOME\" && rmdir *`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=\"$HOME\"\nrmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X='$HOME'; rmdir '$X'`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=.. || rmdir \\$X; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=sub | rmdir p04-fuzz-does-not-exist; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=/; rmdir *; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { declare X=~ || rmdir /usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `X=''; rmdir /`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=${HOME}\nrmdir \\$X"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X='' & rmdir '$X')"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X='$HOME' || rmdir p04-fuzz-does-not-exist/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(typeset X=\"$HOME\" & rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=\"*\" & rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=/usr; rmdir '$X';; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=/ & rmdir \"*\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=sub & rmdir ..; break; done"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
