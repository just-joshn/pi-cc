{
	"id": "removal-fuzz/batch-02",
	"area": "removal-fuzz",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(readonly X=sub; rmdir \\$X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X=\"*\" & rmdir .; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=.. & rmdir /usr)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then local X='*' || rmdir p04-fuzz-does-not-exist; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X=sub && rmdir '$X'; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(export X=/usr || rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then local X=/ || rmdir \\$X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=''\nrmdir /; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=${HOME} && rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X=.. || rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X='*'; rmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(local X=. && rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X='$HOME' | rmdir p04-fuzz-does-not-exist/..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X=${HOME}; rmdir \\$X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=${HOME}\nrmdir ~)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X='' & rmdir ..; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X='*'\nrmdir ~"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=.. & rmdir sub)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=$HOME\nrmdir sub; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=\\$HOME\nrmdir *"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=$HOME | rmdir ~"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do local X='$HOME'; rmdir $HOME; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=. && rmdir p04-fuzz-does-not-exist/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(declare X=p04-fuzz-does-not-exist && rmdir p04-fuzz-does-not-exist/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then local X=/usr; rmdir ${X}/; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X=p04-fuzz-does-not-exist & rmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=${HOME} & rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=/usr; rmdir $HOME; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X=/ | rmdir \\$X;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ X=~ && rmdir ~; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X='' & rmdir \"*\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=\"*\"; rmdir p04-fuzz-does-not-exist/..; done"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
