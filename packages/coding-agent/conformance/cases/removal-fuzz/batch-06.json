{
	"id": "removal-fuzz/batch-06",
	"area": "removal-fuzz",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=~; rmdir *"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=/usr; rmdir ~)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X='*' && rmdir '$X'; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=''\nrmdir \\$X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X='' & rmdir *; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X=\\$HOME; rmdir p04-fuzz-does-not-exist)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=.. & rmdir ..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X='$HOME' | rmdir \"$X\"; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(typeset X=/ & rmdir sub/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=p04-fuzz-does-not-exist & rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(X=~ | rmdir ${X}/)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=\"$HOME\"\nrmdir \\$X`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(readonly X=\\$HOME & rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X=${HOME} && rmdir sub;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=\"$HOME\"; rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=\\$HOME; rmdir *`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=/usr\nrmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(local X=sub && rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X=\\$HOME | rmdir *; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=. && rmdir *; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=\"$HOME\"\nrmdir .`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(readonly X='$HOME'\nrmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=/ & rmdir \\$X)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(export X=\"*\" | rmdir \"$X\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(export X=''\nrmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do local X=/ & rmdir p04-fuzz-does-not-exist/..; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "readonly X='$HOME'; rmdir p04-fuzz-does-not-exist/.."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `export X=\"*\" & rmdir ${X}/`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X=.. || rmdir p04-fuzz-does-not-exist; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=..\nrmdir ..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X=sub || rmdir $HOME; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { local X='*' | rmdir p04-fuzz-does-not-exist; }; true"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
