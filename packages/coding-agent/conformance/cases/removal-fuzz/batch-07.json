{
	"id": "removal-fuzz/batch-07",
	"area": "removal-fuzz",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=${HOME} | rmdir sub`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=/usr & rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=sub | rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(readonly X=${HOME}; rmdir $HOME)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X=\"*\" || rmdir \"*\"; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(typeset X=.. | rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X='$HOME'\nrmdir sub; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=~ && rmdir p04-fuzz-does-not-exist/..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=~ && rmdir ."
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) local X=..; rmdir ${X}/;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=..; rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X='*' | rmdir ..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X='*'\nrmdir '$X')\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ X=\\$HOME; rmdir \\$X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=\"$HOME\" & rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do X=\\$HOME | rmdir sub; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "export X=$HOME || rmdir p04-fuzz-does-not-exist"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X=\\$HOME\nrmdir \"$X\""
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=/usr; rmdir sub)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X=$HOME || rmdir ${X}/;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "export X=$HOME\nrmdir $HOME"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X='*' && rmdir '$X')\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=~\nrmdir \\$X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X=$HOME && rmdir \"*\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(typeset X=. && rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=${HOME} && rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { typeset X=. || rmdir ${X}/; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X='$HOME' || rmdir *; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X=.. & rmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=.\nrmdir p04-fuzz-does-not-exist/..; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(local X=$HOME || rmdir sub)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=.; rmdir ${X}/; break; done"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
