{
	"id": "removal-fuzz/batch-03",
	"area": "removal-fuzz",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X=sub | rmdir '$X';; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do readonly X=$HOME || rmdir ${X}/; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do local X=sub || rmdir sub; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `X=\\$HOME\nrmdir *`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X='*'; rmdir \"*\";; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=~\nrmdir $HOME; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(typeset X=${HOME}; rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "local X='$HOME' || rmdir $HOME"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { declare X='$HOME' || rmdir /usr; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `declare X=\\$HOME | rmdir '$X'`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X=\"$HOME\" | rmdir '$X')"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X=$HOME & rmdir $HOME"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=. && rmdir ${X}/; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X=sub || rmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "typeset X=''; rmdir /"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(readonly X=\"*\" && rmdir \"$X\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X='$HOME' || rmdir sub;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X='$HOME' & rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do export X=$HOME\nrmdir \"*\"; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=/usr\nrmdir *; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { X=\"*\"\nrmdir \\$X; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(declare X=''\nrmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(export X=/ & rmdir ..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=$HOME; rmdir '$X')"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do X=\"$HOME\" & rmdir \"$X\"; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=sub & rmdir *; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=\"*\" || rmdir p04-fuzz-does-not-exist/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=\"*\"\nrmdir /)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(X='*' | rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ local X='*' || rmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=/usr || rmdir \\$X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do typeset X=\"*\" && rmdir *; break; done"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
