{
	"id": "removal-fuzz/batch-08",
	"area": "removal-fuzz",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=sub & rmdir $HOME)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then declare X=${HOME}; rmdir \\$X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X='$HOME' || rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X='' & rmdir \\$X; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X='*'; rmdir sub/..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(export X=/ || rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=sub && rmdir ${X}/)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=p04-fuzz-does-not-exist || rmdir p04-fuzz-does-not-exist; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=~ | rmdir /usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=\\$HOME | rmdir /usr; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=\\$HOME || rmdir sub;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=/ & rmdir /; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X='*' | rmdir p04-fuzz-does-not-exist; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X=\\$HOME && rmdir /usr`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then export X='$HOME' && rmdir $X/usr; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) typeset X='$HOME'\nrmdir ..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ typeset X=.. && rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X=~ & rmdir .; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then typeset X=.. || rmdir '$X'; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) X='*' || rmdir ~;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=\"*\" & rmdir ..; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(export X=\"$HOME\" & rmdir \\$X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) export X=\"$HOME\" || rmdir /;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=\"*\" || rmdir \\$X; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(typeset X=$HOME | rmdir *)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(readonly X=/usr & rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true `readonly X='' && rmdir ~`"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) declare X=\"*\" && rmdir p04-fuzz-does-not-exist;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=$HOME & rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ readonly X=p04-fuzz-does-not-exist; rmdir *; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ local X='$HOME' | rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "X=.\nrmdir ${X}/"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
