{
	"id": "removal-fuzz/batch-13",
	"area": "removal-fuzz",
	"argv": [
		"-p",
		"Run permission probes",
		"--model",
		"claude-opus-4-7",
		"--dangerously-skip-permissions",
		"--output-format",
		"stream-json",
		"--verbose"
	],
	"env": {
		"CLAUDE_CODE_TMPDIR": "$TMP"
	},
	"stdin": null,
	"files": {
		"seed.txt": "SEED\n",
		"sub/seed.txt": "SUB\n"
	},
	"model": {
		"turns": [
			{
				"tool_uses": [
					{
						"name": "Bash",
						"input": {
							"command": "true ${ declare X=sub\nrmdir $X; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=\"*\" && rmdir $X/usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(typeset X='' & rmdir $X/usr)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ export X=${HOME}\nrmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(X=~ && rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=.. && rmdir '$X'; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(typeset X='$HOME'\nrmdir .)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "{ declare X=p04-fuzz-does-not-exist\nrmdir /usr; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "X=\"*\"; rmdir ${X}/"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ readonly X=\"$HOME\" || rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "declare X=\\$HOME; rmdir /"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <(export X='$HOME' | rmdir $X)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<'EOF'\n$(export X='*' & rmdir ~)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then X=/ || rmdir .; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=$HOME | rmdir sub; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "f() { export X=.\nrmdir p04-fuzz-does-not-exist/..; }; true"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=/usr || rmdir *)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ export X=\\$HOME & rmdir \"$X\"; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do readonly X=sub && rmdir ${X}/; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=/ || rmdir \"*\")\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "case one in one) readonly X=/usr & rmdir p04-fuzz-does-not-exist/..;; esac"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true $(declare X=\"*\" & rmdir p04-fuzz-does-not-exist/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "if true; then readonly X=. && rmdir /usr; fi"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "for Y in one; do typeset X=/; rmdir sub; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do export X=\"$HOME\" && rmdir ~; break; done"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X=/; rmdir ~)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(local X=.. || rmdir sub/..)\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true ${ typeset X='*'; rmdir ${X}/; }"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true >(declare X=sub & rmdir sub/..)"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "true <<EOF\n$(declare X=$HOME | rmdir '$X')\nEOF"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "(X=\\$HOME && rmdir \"*\")"
						}
					},
					{
						"name": "Bash",
						"input": {
							"command": "while true; do declare X=\"$HOME\" && rmdir $X; break; done"
						}
					}
				]
			},
			{
				"text": "FUZZ_DONE"
			}
		]
	},
	"timeout_ms": 120000,
	"compare": {
		"exit": 0,
		"stdout": {
			"kind": "text",
			"match": [
				"FUZZ_DONE"
			]
		},
		"requests": [
			{
				"pathStartsWith": "/v1/messages",
				"count": 2
			}
		],
		"files": []
	},
	"skip": []
}
